# Database. Matches docker-compose.dev.yml; production compose sets its own.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_manager?schema=public"

# NextAuth. The secret: at least 32 characters, e.g. `openssl rand -base64 32`;
# the server refuses to start without one (src/lib/env.ts).
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# Server
PORT=3000

# Uploaded files. Defaults to /data/uploads (the image's volume); set a writable
# local path for `npm run dev`. MAX_UPLOAD_BYTES defaults to 104857600 (100MB).
UPLOAD_DIR="./.uploads"
# MAX_UPLOAD_BYTES=104857600

# Mailgun (required for account invites and password reset)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="Event Manager <noreply@example.com>"
# Optional. Defaults to https://api.mailgun.net (US). Set to https://api.eu.mailgun.net for the EU region.
# MAILGUN_BASE_URL=https://api.mailgun.net

# Inbound email (event inboxes, `<org>.<event>@INBOUND_EMAIL_DOMAIN`). Both
# blank turns the inbox off. The secret is shared with the Cloudflare Email
# Worker in workers/email-inbound/ (generate with `openssl rand -hex 32`).
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=
# Claude API key for reading inbox mail (pickup reports). Blank leaves mail
# unread for staff to handle by hand.
ANTHROPIC_API_KEY=

# scripts/import-hotel-manager.ts only (one-off import; see the script header).
# HM_DATABASE_URL=
# HM_UPLOADS_DIR=
