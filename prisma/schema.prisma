model MediaDeliverableFunction {
  id                 String           @id @default(cuid())
  mediaDeliverableId String
  functionId         String
  mediaDeliverable   MediaDeliverable @relation(fields: [mediaDeliverableId], references: [id], onDelete: Cascade)
  function           Function         @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([mediaDeliverableId, functionId])
  @@index([functionId])
}

model MediaDeliverablePresentation {
  id                 String           @id @default(cuid())
  mediaDeliverableId String
  presentationId     String
  mediaDeliverable   MediaDeliverable @relation(fields: [mediaDeliverableId], references: [id], onDelete: Cascade)
  presentation       Presentation     @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@unique([mediaDeliverableId, presentationId])
  @@index([presentationId])
}

model MediaDeliverableContact {
  id                 String           @id @default(cuid())
  mediaDeliverableId String
  contactId          String
  role               String?
  mediaDeliverable   MediaDeliverable @relation(fields: [mediaDeliverableId], references: [id], onDelete: Cascade)
  contact            Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([mediaDeliverableId, contactId])
  @@index([contactId])
}

model PrintOrder {
  id               String               @id @default(cuid())
  name             String
  status           EntityStatus?
  substatus        String?
  packingStatus    PackingStatus?
  eventId          String
  event            Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roomId           String?
  room             Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  specificLocation String?
  presentationId   String?              @unique
  presentation     Presentation?        @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  notes            String?
  functions        PrintOrderFunction[]
  items            PrintItem[]
  vendors          PrintOrderVendor[]
  files            FileUpload[]
  rfpLineItems     RfpLineItem[]
  updatedById      String?
  updatedBy        User?                @relation("PrintOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([eventId])
  @@index([roomId])
  @@index([updatedById])
}

model PrintOrderFunction {
  id           String     @id @default(cuid())
  printOrderId String
  functionId   String
  printOrder   PrintOrder @relation(fields: [printOrderId], references: [id], onDelete: Cascade)
  function     Function   @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([printOrderId, functionId])
  @@index([functionId])
}

model PrintItem {
  id                 String           @id @default(cuid())
  printOrderId       String
  printOrder         PrintOrder       @relation(fields: [printOrderId], references: [id], onDelete: Cascade)
  description        String
  quantity           Int?
  acquisitionState   AcquisitionState @default(TO_PROCURE)
  packingStatus      PackingStatus    @default(NEEDED)
  distributionMethod String?
  distributionNotes  String?
  designerVendorId   String?
  designerVendor     Vendor?          @relation("PrintItemDesignerVendor", fields: [designerVendorId], references: [id], onDelete: SetNull)
  designerContactId  String?
  designerContact    Contact?         @relation("PrintItemDesignerContact", fields: [designerContactId], references: [id], onDelete: SetNull)
  printerVendorId    String?
  printerVendor      Vendor?          @relation("PrintItemPrinterVendor", fields: [printerVendorId], references: [id], onDelete: SetNull)
  printerContactId   String?
  printerContact     Contact?         @relation("PrintItemPrinterContact", fields: [printerContactId], references: [id], onDelete: SetNull)
  notes              String?
  sortOrder          Int              @default(0)
  rfpLineItems       RfpLineItem[]

  // Where this item comes from. Print items can be sourced from a container but
  // can't *be* one — container lines are supply-side only.
  sourceLocationId String?
  sourceLocation   StorageLocation? @relation("PrintItemSourceLocation", fields: [sourceLocationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([printOrderId])
  @@index([designerVendorId])
  @@index([designerContactId])
  @@index([printerVendorId])
  @@index([printerContactId])
  @@index([sourceLocationId])
}

// Junction: PrintOrder <-> Vendor
model PrintOrderVendor {
  id           String     @id @default(cuid())
  printOrderId String
  vendorId     String
  notes        String?
  printOrder   PrintOrder @relation(fields: [printOrderId], references: [id], onDelete: Cascade)
  vendor       Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([printOrderId, vendorId])
  @@index([printOrderId])
}

// SupplyOrder is a destination-bundle ("Registration Kit") packed for a room.
// Order header carries destination Room + identity + provider; items carry
// state/packing and may override the order's provider.
model SupplyOrder {
  id                String                    @id @default(cuid())
  name              String
  status            EntityStatus?
  substatus         String?
  eventId           String
  event             Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roomId            String?
  room              Room?                     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  specificLocation  String?
  notes             String?
  providerVendorId  String?
  providerVendor    Vendor?                   @relation("SupplyOrderProviderVendor", fields: [providerVendorId], references: [id], onDelete: SetNull)
  providerContactId String?
  providerContact   Contact?                  @relation("SupplyOrderProviderContact", fields: [providerContactId], references: [id], onDelete: SetNull)
  functions         SupplyOrderFunction[]
  presentations     SupplyOrderPresentation[]
  items             SupplyOrderItem[]
  files             FileUpload[]
  updatedById       String?
  updatedBy         User?                     @relation("SupplyOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([eventId])
  @@index([roomId])
  @@index([updatedById])
  @@index([providerVendorId])
  @@index([providerContactId])
}

model SupplyOrderItem {
  id                String           @id @default(cuid())
  supplyOrderId     String
  supplyOrder       SupplyOrder      @relation(fields: [supplyOrderId], references: [id], onDelete: Cascade)
  description       String?
  equipmentId       String?
  equipment         Equipment?       @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  quantity          Int?
  acquisitionState  AcquisitionState @default(ON_HAND)
  providerVendorId  String?
  providerVendor    Vendor?          @relation("SupplyOrderItemProviderVendor", fields: [providerVendorId], references: [id], onDelete: SetNull)
  providerContactId String?
  providerContact   Contact?         @relation("SupplyOrderItemProviderContact", fields: [providerContactId], references: [id], onDelete: SetNull)
  packingStatus     PackingStatus    @default(NEEDED)
  notes             String?
  sortOrder         Int              @default(0)

  // Where this item comes from. On a container line (containerLocationId set)
  // it means something else: where that container sits for this event.
  sourceLocationId String?
  sourceLocation   StorageLocation? @relation("SupplyItemSourceLocation", fields: [sourceLocationId], references: [id], onDelete: SetNull)

  // Set when this line *is* a container being shipped, rather than an item
  // inside one. Container lines are excluded from equipment aggregates.
  containerLocationId String?
  containerLocation   StorageLocation? @relation("SupplyItemContainer", fields: [containerLocationId], references: [id], onDelete: SetNull)

  // Provenance only — set when this line was pulled from durable inventory, or
  // when a post-event repack filed it back. Never decrements the inventory row.
  // SetNull so retiring an inventory record doesn't erase order history.
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation("SupplyItemInventoryItem", fields: [inventoryItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplyOrderId])
  @@index([equipmentId])
  @@index([providerVendorId])
  @@index([providerContactId])
  @@index([sourceLocationId])
  @@index([containerLocationId])
  @@index([inventoryItemId])
}

model SupplyOrderFunction {
  id            String      @id @default(cuid())
  supplyOrderId String
  functionId    String
  supplyOrder   SupplyOrder @relation(fields: [supplyOrderId], references: [id], onDelete: Cascade)
  function      Function    @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([supplyOrderId, functionId])
  @@index([functionId])
}

model SupplyOrderPresentation {
  id             String       @id @default(cuid())
  supplyOrderId  String
  presentationId String
  supplyOrder    SupplyOrder  @relation(fields: [supplyOrderId], references: [id], onDelete: Cascade)
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@unique([supplyOrderId, presentationId])
  @@index([presentationId])
}

model FileUpload {
  id         String  @id @default(cuid())
  fileName   String
  storedName String
  mimeType   String
  fileSize   Int
  fileType   String?

  eventId            String?
  event              Event?            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  cateringOrderId    String?
  cateringOrder      CateringOrder?    @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  avOrderId          String?
  avOrder            AVOrder?          @relation(fields: [avOrderId], references: [id], onDelete: Cascade)
  setupOrderId       String?
  setupOrder         SetupOrder?       @relation(fields: [setupOrderId], references: [id], onDelete: Cascade)
  printOrderId       String?
  printOrder         PrintOrder?       @relation(fields: [printOrderId], references: [id], onDelete: Cascade)
  supplyOrderId      String?
  supplyOrder        SupplyOrder?      @relation(fields: [supplyOrderId], references: [id], onDelete: Cascade)
  mediaDeliverableId String?
  mediaDeliverable   MediaDeliverable? @relation(fields: [mediaDeliverableId], references: [id], onDelete: Cascade)
  venueId            String?
  venue              Venue?            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  hotelProposalId    String?
  hotelProposal      HotelProposal?    @relation(fields: [hotelProposalId], references: [id], onDelete: Cascade)
  rfpId              String?
  rfp                Rfp?              @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  // Arrived on an inbound email. Filing it on the event copies it (same
  // storedName) rather than moving it, so the item keeps its own copy.
  inboundEmailId     String?
  inboundEmail       InboundEmail?     @relation(fields: [inboundEmailId], references: [id], onDelete: Cascade)
  vendorQuoteId      String?
  vendorQuote        VendorQuote?      @relation(fields: [vendorQuoteId], references: [id], onDelete: Cascade)
  // Uploaded through a public form. Applying copies it onto the record, as
  // inbound-email attachments are filed.
  formSubmissionId   String?
  formSubmission     FormSubmission?   @relation(fields: [formSubmissionId], references: [id], onDelete: Cascade)
  // A contact's own files (a speaker headshot). Contacts are tenant-wide.
  contactId          String?
  contact            Contact?          @relation("ContactFiles", fields: [contactId], references: [id], onDelete: Cascade)
  headshotOf         Contact?          @relation("ContactHeadshot")

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([cateringOrderId])
  @@index([avOrderId])
  @@index([setupOrderId])
  @@index([printOrderId])
  @@index([supplyOrderId])
  @@index([mediaDeliverableId])
  @@index([venueId])
  @@index([hotelProposalId])
  @@index([inboundEmailId])
  @@index([rfpId])
  @@index([vendorQuoteId])
  @@index([formSubmissionId])
  @@index([contactId])
}

model ShareLink {
  id             String    @id @default(cuid())
  token          String    @unique
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
