}

// PER §VIII future event dates.
model EventPostEventFutureDate {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  city      String?
  state     String?
  country   String?
  facility  String?
  comments  String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([eventId])
}

// PER §IX report distribution tracking. action: "COMPLETED" | "REVISED".
model EventPostEventDistribution {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  action      String
  actionDate  DateTime? @db.Date
  byName      String?
  byTitle     String?
  byEmployer  String?
  method      String?
  deliveredOn DateTime? @db.Date
  recipients  String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Hotels module (ported from Hotel-Manager). A proposal is one lodging venue's
// offer for one event; accepting it lets staff open that hotel's block. Rooms
// are stored per room type per night — every rate, availability and pickup
// figure hangs off (roomType, night). roomType is a hotel_room_type option
// label; null means run of house.

// Contract carries attrition liability; courtesy is held without it. Who the
// rooms are for is the separate guestType (hotel_guest_type option label).
enum HotelContractType {
  CONTRACT
  COURTESY
}

enum HotelChargeScope {
  PER_NIGHT
  PER_STAY
  PER_PERSON
  PER_PERSON_PER_NIGHT
}

model HotelProposal {
  id                  String                    @id @default(cuid())
  eventId             String
  event               Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venueId             String
  venue               Venue                     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  // proposal_status option label; the option's group (REQUESTED / PENDING /
  // ACCEPTED / DECLINED) is the workflow stage the app keys off.
  status              String
  // Where the lead came from: the hotel directly, or a lead-source vendor (a
  // CVB, a third-party planner) and its contact. Neither = not set.
  leadSourceDirect    Boolean                   @default(false)
  leadSourceVendorId  String?
  leadSourceVendor    Vendor?                   @relation("HotelProposalLeadSource", fields: [leadSourceVendorId], references: [id], onDelete: SetNull)
  leadSourceContactId String?
  leadSourceContact   Contact?                  @relation("HotelProposalLeadSourceContact", fields: [leadSourceContactId], references: [id], onDelete: SetNull)
  contractType        HotelContractType?
  guestType           String? // hotel_guest_type option label
  submittedOn         DateTime?                 @db.Date
  checkIn             DateTime?                 @db.Date
  checkOut            DateTime?                 @db.Date
  declinedReason      String?
  notes               String?
  // Bumped by staff when the hotel sends a revised offer; each bump records a
  // HotelProposalVersion.
  revision            Int                       @default(1)
  allowedAttrition    Decimal?                  @db.Decimal(5, 2)
  guaranteedRevenue   Decimal?                  @db.Decimal(10, 2)
  // Rates good until / contract by, as the offer states it.
  validUntil          DateTime?                 @db.Date
  // Whether the quoted rates include taxes and fees; null = not stated.
  taxIncluded         Boolean?
  // Amenities this offer confirms or says are unavailable; the rest are the
  // hotel's profile, unstated.
  amenities           HotelProposalAmenity[]
  nights              HotelProposalNight[]
  charges             HotelCharge[]
  versions            HotelProposalVersion[]
  block               HotelBlock?
  files               FileUpload[]
  // The RFP and requested block this offer answers, when it came from one.
  rfpId               String?
  rfp                 Rfp?                      @relation(fields: [rfpId], references: [id], onDelete: SetNull)
  rfpBlockId          String?
  rfpBlock            RfpHotelBlock?            @relation(fields: [rfpBlockId], references: [id], onDelete: SetNull)
  concessions         HotelProposalConcession[]
  updatedById         String?
  updatedBy           User?                     @relation("HotelProposalUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([eventId])
  @@index([venueId])
  @@index([updatedById])
  @@index([rfpId])
  @@index([rfpBlockId])
  @@index([leadSourceVendorId])
  @@index([leadSourceContactId])
}

model HotelProposalNight {
  id         String        @id @default(cuid())
  proposalId String
  proposal   HotelProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  roomType   String? // null = Run of House
  night      DateTime      @db.Date
  rate       Decimal?      @db.Decimal(10, 2)
  rooms      Int?

  @@index([proposalId])
}

model HotelCharge {
  id         String            @id @default(cuid())
  proposalId String?
  proposal   HotelProposal?    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  blockId    String?
  block      HotelBlock?       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  chargeType String
  amount     Decimal?          @db.Decimal(10, 2)
  scope      HotelChargeScope?
  sortOrder  Int               @default(0)

  @@index([proposalId])
  @@index([blockId])
}

// The proposal as it stood at one revision: snapshot is the full proposal
// (fields, nights, charges, amenities); changes lists what differs from the
// previous revision as { field, from, to }.
model HotelProposalVersion {
  id          String        @id @default(cuid())
  proposalId  String
  proposal    HotelProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revision    Int
  summary     String?
  snapshot    Json
  changes     Json          @default("[]")
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@unique([proposalId, revision])
  @@index([createdById])
}

// The booked block an accepted proposal became (1:1). Nights start as copies
// of the proposal's: contractedRooms keeps the signed number, rooms is the
// current (final) block. Pickup is computed, never stored per night — see
// src/lib/hotelPickup.ts.
model HotelBlock {
  id                String                @id @default(cuid())
  proposalId        String                @unique
  proposal          HotelProposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  isHq              Boolean               @default(false)
  checkIn           DateTime?             @db.Date
  checkOut          DateTime?             @db.Date
  reservationMethod String? // reservation_method option label
  groupCode         String?
  bookingLink       String?
  bookingPhone      String?
  cutoffDate        DateTime?             @db.Date
  contractedOn      DateTime?             @db.Date
  cutoffExercised   Boolean?
  allowedAttrition  Decimal?              @db.Decimal(5, 2)
  guaranteedRevenue Decimal?              @db.Decimal(10, 2)
  distanceMiles     Decimal?              @db.Decimal(10, 2)
  driveMinutes      Int?
  compRooms         Int?
  staffRooms        Int?
  notes             String?
  nights            HotelBlockNight[]
  charges           HotelCharge[]
  pickupImports     HotelPickupImport[]
  pickupGuests      HotelPickupGuest[]
  pickupCounts      HotelPickupCount[]
  pickupSnapshots   HotelPickupSnapshot[]
  updatedById       String?
  updatedBy         User?                 @relation("HotelBlockUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([updatedById])
}

model HotelBlockNight {
  id                String     @id @default(cuid())
  blockId           String
  block             HotelBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  roomType          String? // null = Run of House
  night             DateTime   @db.Date
  rate              Decimal?   @db.Decimal(10, 2)
  contractedRooms   Int?
  rooms             Int        @default(0)
  // Reservations the hotel's report doesn't carry (booked by staff, etc.).
  otherReservations Int        @default(0)

  @@index([blockId])
}

enum HotelPickupMethod {
  APPEND
  MERGE
  REPLACE
  COUNTS
}

// One pickup upload or count entry, for the block's history. The current
// pickup is the block's guests and counts, not any one import.
model HotelPickupImport {
  id           String             @id @default(cuid())
  blockId      String
  block        HotelBlock         @relation(fields: [blockId], references: [id], onDelete: Cascade)
  method       HotelPickupMethod
  fileName     String?
  inserted     Int                @default(0)
  updated      Int                @default(0)
  notes        String?
  importedById String?
  importedBy   User?              @relation(fields: [importedById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  guests       HotelPickupGuest[]

  @@index([blockId])
  @@index([importedById])
}

// A reservation from the hotel's pickup report. Its nights are check-in up to
// check-out; cancelled guests are kept but never counted.
model HotelPickupGuest {
  id                 String             @id @default(cuid())
  blockId            String
  block              HotelBlock         @relation(fields: [blockId], references: [id], onDelete: Cascade)
  importId           String?
  import             HotelPickupImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  guestName          String?
  confirmationNumber String?
  checkIn            DateTime?          @db.Date
  checkOut           DateTime?          @db.Date
  roomType           String?
  cancelled          Boolean            @default(false)
  rawStatus          String?
  // When the reservation was made / cancelled, from reports that carry them.
  // They let the PER compute pickup at N days out from the guest list.
  bookedOn           DateTime?          @db.Date
  cancelledOn        DateTime?          @db.Date

  @@index([blockId, confirmationNumber])
  @@index([importId])
}

// Rooms picked up on a night, entered by hand when the hotel sends totals
// instead of a guest list. roomType null is a run-of-house (all types) total.
model HotelPickupCount {
  id       String     @id @default(cuid())
  blockId  String
  block    HotelBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  night    DateTime   @db.Date
  roomType String?
  rooms    Int

  @@index([blockId])
}

// Pickup per night as it stood on a day — written whenever pickup changes —
// so the PER can report pickup at 90/60/30/21/14/7 days out.
model HotelPickupSnapshot {
  id      String     @id @default(cuid())
  blockId String
  block   HotelBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  takenOn DateTime   @db.Date
  nights  Json // { "YYYY-MM-DD": rooms }

  @@unique([blockId, takenOn])
}

// ---------------------------------------------------------------------------
// RFPs — what we ask vendors for. Generic header; each kind hangs its own
// requested detail off it (hotels: RfpHotelBlock). See docs/proposals/rfp-tools.md.

enum RfpKind {
  HOTEL
  AV
  CATERING
  PRINT
  OTHER
}

enum RfpStatus {
  DRAFT
  ISSUED
  CLOSED
}

model Rfp {
  id                   String             @id @default(cuid())
  eventId              String
  event                Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind                 RfpKind
  // OTHER: what is being bought (an rfp_service option label).
  service              String?
  title                String
  status               RfpStatus          @default(DRAFT)
  responseDue          DateTime?          @db.Date
  decisionBy           DateTime?          @db.Date
  issuedOn             DateTime?          @db.Date
  // Document parts that are on; keys from RFP_SECTIONS (src/lib/rfp/sections.ts).
  sections             String[]           @default([])
  introduction         String? // RichTextEditor HTML
  requirements         String? // RichTextEditor HTML
  // Our point of contact, printed on the document.
  contactId            String?
  contact              Contact?           @relation("RfpContact", fields: [contactId], references: [id], onDelete: SetNull)
  // Requested arrival / departure (the preferred dates); a block grid's
  // nights default to them, and peakRooms fills those nights.
  arrivalDate          DateTime?          @db.Date
  departureDate        DateTime?          @db.Date
  datesFlexible        Boolean            @default(false)
  dateNotes            String?
  alternateDates       RfpAlternateDate[]
  peakRooms            Int?
  // Event history shows only blocks of this RFP's contract / guest types.
  historyMatching      Boolean            @default(false)
  reservationMethod    String? // reservation_method option label
  commissionNotes      String? // rebates, assessments or commissions on rates
  fbMinimum            Decimal?           @db.Decimal(10, 2)
  // What the F&B minimum includes: keys from FB_INCLUDES (src/lib/rfp/sections.ts).
  fbIncludes           String[]           @default([])
  fbHistoricalSpend    Decimal?           @db.Decimal(10, 2)
  amenities            String[]           @default([]) // hotel_amenity option labels
  // Final decision maker: a contact (usually key staff) or free text.
  decisionMakerId      String?
  decisionMakerContact Contact?           @relation("RfpDecisionMaker", fields: [decisionMakerId], references: [id], onDelete: SetNull)
  decisionMaker        String?
  // Regions / areas the RFP targets; both empty uses the event's.
  regions              String[]           @default([])
  areas                String[]           @default([])
  siteVisitBy          DateTime?          @db.Date
  spaceRequests        RfpSpaceRequest[]
  recipients           RfpRecipient[]
  concessions          RfpConcession[]
  hotelBlocks          RfpHotelBlock[]
  hotelProposals       HotelProposal[]
  lineItems            RfpLineItem[]
  quotes               VendorQuote[]
  files                FileUpload[]
  updatedById          String?
  updatedBy            User?              @relation("RfpUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([eventId])
  @@index([contactId])
  @@index([decisionMakerId])
  @@index([updatedById])
}

// Who an RFP went to: hotels are Venues, other kinds Vendors.
// An alternate arrival / departure the event could move to (APEX allows three).
model RfpAlternateDate {
  id        String   @id @default(cuid())
  rfpId     String
  rfp       Rfp      @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  sortOrder Int      @default(0)

  @@index([rfpId])
}

enum RfpSpaceKind {
  MEETING
  FB
}

// One row of the RFP's function-space grid (APEX "Function Space and F & B
// Requirements"). Owned by the RFP: copied from a function or catering order
// (functionId / cateringOrderId remember which) or entered by hand. Times are
// event-local "HH:MM".
model RfpSpaceRequest {
  id              String         @id @default(cuid())
  rfpId           String
  rfp             Rfp            @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  kind            RfpSpaceKind
  functionId      String?
  function        Function?      @relation(fields: [functionId], references: [id], onDelete: SetNull)
  cateringOrderId String?
  cateringOrder   CateringOrder? @relation(fields: [cateringOrderId], references: [id], onDelete: SetNull)
  day             DateTime?      @db.Date // null = not scheduled yet
  // Repeats daily through this day (same times), or spans to it with a 24-hr hold.
  endDay          DateTime?      @db.Date
  startTime       String?
  endTime         String?
  // function_type label for MEETING rows, meal_type label for FB rows.
  functionType    String?
  name            String
  attendance      Int?
  setup           String? // setup_type option label
  areaSqFt        Int?
  av              String?
  hold24          Boolean        @default(false)
  room            String?
  sortOrder       Int            @default(0)

  @@index([rfpId])
  @@index([functionId])
  @@index([cateringOrderId])
}

model RfpRecipient {
  id            String    @id @default(cuid())
  rfpId         String
  rfp           Rfp       @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  venueId       String?
  venue         Venue?    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  vendorId      String?
  vendor        Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sentOn        DateTime? @db.Date
  declinedToBid Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())

  @@unique([rfpId, venueId])
  @@unique([rfpId, vendorId])
  @@index([venueId])
  @@index([vendorId])
}

// A term we ask for. label is an rfp_concession option label (free text
// allowed); value is free text ("1/40", "20%", "30 days").
model RfpConcession {
  id        String                    @id @default(cuid())
  rfpId     String
  rfp       Rfp                       @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  label     String
  value     String?
  required  Boolean                   @default(false)
  sortOrder Int                       @default(0)
  responses HotelProposalConcession[]

  @@index([rfpId])
}

enum ConcessionMet {
  MET
  PARTIAL
  NOT_MET
}

// A proposal's answer to one requested concession of its RFP.
enum AmenityStatus {
  CONFIRMED // the offer commits to it
  UNAVAILABLE // the offer says it won't be available for this event
}

// One amenity as a proposal states it, against the hotel's profile.
model HotelProposalAmenity {
  id         String        @id @default(cuid())
  proposalId String
  proposal   HotelProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  label      String // hotel_amenity option label
  status     AmenityStatus
  note       String? // the offer's wording, dates
  sortOrder  Int           @default(0)

  @@unique([proposalId, label])
}

// A concession in a proposal: an answer to one the RFP requested
// (concessionId, met), or one the hotel offered unasked (label, no met).
model HotelProposalConcession {
  id           String         @id @default(cuid())
  proposalId   String
  proposal     HotelProposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  concessionId String?
  concession   RfpConcession? @relation(fields: [concessionId], references: [id], onDelete: Cascade)
  label        String? // rfp_concession option label; unrequested rows only
  offered      String?
  met          ConcessionMet?
  sortOrder    Int            @default(0)

  @@unique([proposalId, concessionId])
  @@index([concessionId])
}

// One requested hotel block (contract attendee / courtesy attendee / staff).
model RfpHotelBlock {
  id                 String               @id @default(cuid())
  rfpId              String
  rfp                Rfp                  @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  contractType       HotelContractType
  guestType          String? // hotel_guest_type option label
  targetRate         Decimal?             @db.Decimal(10, 2)
  // A ceiling ("must be no more than") rather than a target to aim for.
  targetRateRequired Boolean              @default(false)
  notes              String?
  sortOrder          Int                  @default(0)
  nights             RfpHotelBlockNight[]
  proposals          HotelProposal[]

  @@index([rfpId])
}

model RfpHotelBlockNight {
  id       String        @id @default(cuid())
  blockId  String
  block    RfpHotelBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  roomType String? // null = run of house
  night    DateTime      @db.Date
  rooms    Int

  @@index([blockId])
}

// One thing a vendor RFP asks for. Copied from an order (the source ids
// remember which; SetNull) or typed in. group is the heading it prints under
// (the order's name by default); day / times are event-local.
model RfpLineItem {
  id                 String                 @id @default(cuid())
  rfpId              String
  rfp                Rfp                    @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  group              String?
  description        String
  quantity           Int?
  unit               String?
  day                DateTime?              @db.Date
  endDay             DateTime?              @db.Date
  startTime          String?
  endTime            String?
  notes              String?
  avOrderId          String?
  avOrder            AVOrder?               @relation(fields: [avOrderId], references: [id], onDelete: SetNull)
  cateringOrderId    String?
  cateringOrder      CateringOrder?         @relation(fields: [cateringOrderId], references: [id], onDelete: SetNull)
  printOrderId       String?
  printOrder         PrintOrder?            @relation(fields: [printOrderId], references: [id], onDelete: SetNull)
  equipmentItemId    String?
  equipmentItem      EquipmentItem?         @relation(fields: [equipmentItemId], references: [id], onDelete: SetNull)
  printItemId        String?
  printItem          PrintItem?             @relation(fields: [printItemId], references: [id], onDelete: SetNull)
  cateringLineItemId String?
  cateringLineItem   CateringOrderLineItem? @relation(fields: [cateringLineItemId], references: [id], onDelete: SetNull)
  sortOrder          Int                    @default(0)
  quoteLines         VendorQuoteLine[]

  @@index([rfpId])
  @@index([avOrderId])
  @@index([cateringOrderId])
  @@index([printOrderId])
  @@index([equipmentItemId])
  @@index([printItemId])
  @@index([cateringLineItemId])
}

enum QuoteStatus {
  RECEIVED
  ACCEPTED
  DECLINED
}

// A vendor's price for event work: an answer to a vendor RFP, or standalone.
// Event-scoped (tenant via the event). Total = the lines + the fees.
model VendorQuote {
  id                String            @id @default(cuid())
  eventId           String
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rfpId             String?
  rfp               Rfp?              @relation(fields: [rfpId], references: [id], onDelete: SetNull)
  status            QuoteStatus       @default(RECEIVED)
  reference         String? // the vendor's quote number
  submittedOn       DateTime?         @db.Date
  validUntil        DateTime?         @db.Date
  revision          Int               @default(1)
  serviceCharge     Decimal?          @db.Decimal(10, 2)
  tax               Decimal?          @db.Decimal(10, 2)
  otherFees         Decimal?          @db.Decimal(10, 2)
  depositAmount     Decimal?          @db.Decimal(10, 2)
  depositDue        DateTime?         @db.Date
  cancellationTerms String?
  notes             String?
  lines             VendorQuoteLine[]
  files             FileUpload[]
  updatedById       String?
  updatedBy         User?             @relation("VendorQuoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([eventId])
  @@index([vendorId])
  @@index([rfpId])
  @@index([updatedById])
}

// One priced line of a quote: an answer to an RFP line (rfpLineItemId) or
// an extra the vendor added. amount is as quoted; else quantity × unitPrice.
model VendorQuoteLine {
  id            String       @id @default(cuid())
  quoteId       String
  quote         VendorQuote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfpLineItemId String?
  rfpLineItem   RfpLineItem? @relation(fields: [rfpLineItemId], references: [id], onDelete: SetNull)
  description   String
  quantity      Decimal?     @db.Decimal(10, 2)
  unitPrice     Decimal?     @db.Decimal(10, 2)
  amount        Decimal?     @db.Decimal(10, 2)
  notes         String?
  sortOrder     Int          @default(0)

  @@index([quoteId])
  @@index([rfpLineItemId])
}

// ---------------------------------------------------------------------------
// Email ingest — mail sent to an event's inbox address. See
// docs/proposals/email-ingest.md.

enum InboundOrigin {
  EMAIL
  MCP
  UPLOAD // dropped onto the event inbox in the app
}

enum InboundStatus {
  HELD // unknown sender, or no event matched: waits for a person
  RECEIVED // known sender, waiting to be read
  PARSED // a proposal is ready for review
  APPLIED
  DISMISSED // purged 90 days after handledAt
  FAILED // reading it failed; can be re-run
}

// One message. Tenant-owned: tenantId comes from the address; eventId is null
// while the address named no event of that tenant ("Unrouted"). The raw .eml
// and the attachments are FileUploads (inboundEmailId); the .eml's fileType is
// "EMAIL_SOURCE".
model InboundEmail {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId       String?
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  origin        InboundOrigin @default(EMAIL)
  // msgid:<Message-ID> or hash:<sha256> — a resend of the same message is a no-op.
  dedupKey      String        @unique
  envelopeTo    String
  envelopeFrom  String?
  // From: as written ("Name <address>"), and its bare address for matching.
  sender        String
  senderAddress String?
  // The original sender when this message forwards another one.
  forwardedFrom String?
  subject       String?
  receivedAt    DateTime
  textBody      String?       @db.Text
  // Authentication-Results as received (SPF / DKIM / DMARC).
  authResults   String?
  // Who the sender is to this tenant / event: MEMBER, CONTACT, or null (unknown).
  senderMatch   String?
  status        InboundStatus
  // What the message was read as, and the proposed record (phase 2+).
  kind          String?
  proposal      Json?
  model         String?
  error         String?
  // The person who last released, dismissed or applied it.
  handledById   String?
  handledBy     User?         @relation("InboundEmailHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt     DateTime?
  files         FileUpload[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId, eventId, status])
  @@index([eventId, status])
  @@index([handledById])
}

// ─── Public forms ────────────────────────────────────────────────────────────
// Tokenized links (/f/<token>) people without an account fill in. A submission
// never writes to live records: staff review it, optionally through an
// approval workflow, and apply it section by section. See docs/forms.md.

enum FormType {
  FUNCTION_REVIEW
  ITEM_REQUEST
  EXHIBIT_REQUEST
  PRESENTATION_DELIVERABLES
  SPEAKER_PROFILE
}

enum FormSubmissionState {
  DRAFT
  SUBMITTED
  APPLIED
  REJECTED
  WITHDRAWN
}

model FormLink {
  id                 String             @id @default(cuid())
  token              String             @unique
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId            String
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formType           FormType
  // Target of a single-recipient form; open forms leave these null.
  functionId         String?
  function           Function?          @relation(fields: [functionId], references: [id], onDelete: Cascade)
  contactId          String?
  contact            Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  presentationId     String?
  presentation       Presentation?      @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  // Exhibit requests may be scoped to one booth group.
  boothGroupId       String?
  boothGroup         ExhibitBoothGroup? @relation(fields: [boothGroupId], references: [id], onDelete: Cascade)
  // A bundle is one link (and one email) over several child links: a Function
  // Review of several functions, or a speaker's profile and deliverables. It
  // holds no target and takes no submissions; each child is a normal link.
  bundle             Boolean            @default(false)
  parentId           String?
  parent             FormLink?          @relation("FormLinkBundle", fields: [parentId], references: [id], onDelete: Cascade)
  children           FormLink[]         @relation("FormLinkBundle")
  // { sections: string[], intro?: string }
  config             Json               @default("{}")
  label              String?
  recipientName      String?
  recipientEmail     String?
  // Approval workflow assigned to every submission; apply waits for it.
  workflowTemplateId String?
  workflowTemplate   WorkflowTemplate?  @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  dueAt              DateTime?
  expiresAt          DateTime
  revokedAt          DateTime?
  maxSubmissions     Int?
  submittedCount     Int                @default(0)
  createdById        String?
  createdBy          User?              @relation("FormLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastAccessedAt     DateTime?
  accessCount        Int                @default(0)
  submissions        FormSubmission[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([tenantId])
  @@index([eventId])
  @@index([functionId])
  @@index([contactId])
  @@index([presentationId])
  @@index([boothGroupId])
  @@index([parentId])
  @@index([workflowTemplateId])
  @@index([createdById])
}

model FormSubmission {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId            String
  event              Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formLinkId         String
  formLink           FormLink            @relation(fields: [formLinkId], references: [id], onDelete: Cascade)
  formType           FormType
  state              FormSubmissionState @default(DRAFT)
  // Ties a draft and its uploads to one browser (an HttpOnly cookie); there
  // is no session on the public side.
  draftKey           String              @unique
  // Driven by the approval workflow, as on orders.
  status             EntityStatus?
  substatus          String?
  // The approval template the link required at submit; apply refuses unless an
  // instance of it is present and complete.
  requiredTemplateId String?
  submitterName      String?
  submitterEmail     String?
  submitterOrg       String?
  payload            Json                @default("{}")
  // The public projection of the target as the submitter saw it.
  baseline           Json?
  applyResult        Json?
  reviewNotes        String?
  handledById        String?
  handledBy          User?               @relation("FormSubmissionHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt          DateTime?
  submittedAt        DateTime?
  files              FileUpload[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([tenantId])
  @@index([eventId, state])
  @@index([formLinkId, createdAt])
  @@index([handledById])
}

// A speaker's facts for one event (proposal #55, minimal slice): travel,
// needs, notes. Durable facts (bio, headshot) live on Contact.
model SpeakerProfile {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  arrivalAt     DateTime?
  departureAt   DateTime?
  travelNotes   String?
  hotel         String?
  dietary       String?
  avNeeds       String?
  shirtSize     String?
  notes         String?
  internalNotes String?
  updatedById   String?
  updatedBy     User?     @relation("SpeakerProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([eventId, contactId])
  @@index([contactId])
  @@index([updatedById])
}
