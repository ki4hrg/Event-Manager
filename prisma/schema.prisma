  createdAt  DateTime @default(now())

  @@unique([functionId, roomId])
  @@unique([functionId, suffix])
}

// Settings shared by a set of booths (e.g. "Standard 10x10"). Every column
// after `name` mirrors one on ExhibitBooth; a booth's own value wins, a blank
// one falls back to its group (src/lib/boothGroups.ts).
model ExhibitBoothGroup {
  id                    String          @id @default(cuid())
  eventId               String
  event                 Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name                  String
  functionId            String?
  function              Function?       @relation(fields: [functionId], references: [id], onDelete: SetNull)
  location              String?
  boothType             String?
  startAt               DateTime?
  endAt                 DateTime?
  setupBy               DateTime?
  teardownBy            DateTime?
  specialRequirements   String?
  setupNotes            String?
  avProvider            ProvidedBy?
  avNotes               String?
  fbNotes               String?
  decorNotes            String?
  securityNotes         String?
  signageNotes          String?
  shippingRequired      Boolean?
  customsRequired       Boolean?
  materialHandlingNotes String?
  electricalProvider    ProvidedBy?
  electricalNotes       String?
  utilitiesNotes        String?
  taxExempt             Boolean?
  taxExemptId           String?
  costCenter            String?
  billingNotes          String?
  sortOrder             Int             @default(0)
  booths                ExhibitBooth[]
  equipmentItems        EquipmentItem[]
  updatedById           String?
  updatedBy             User?           @relation("ExhibitBoothGroupUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  formLinks             FormLink[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([eventId])
  @@index([functionId])
  @@index([updatedById])
}

// ESG Part IIIb — one Booth Set-up Order per exhibit booth. Usually listed
// under the event's exhibit function (the master exhibit function); times
// left empty inherit from the group, then that function's schedules.
model ExhibitBooth {
  id                    String             @id @default(cuid())
  eventId               String
  event                 Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  groupId               String?
  group                 ExhibitBoothGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  functionId            String?
  function              Function?          @relation(fields: [functionId], references: [id], onDelete: SetNull)
  boothNumber           String?
  location              String?
  boothType             String?
  name                  String
  companyName           String?
  contactId             String?
  contact               Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  startAt               DateTime?
  endAt                 DateTime?
  setupBy               DateTime?
  teardownBy            DateTime?
  specialRequirements   String?
  setupNotes            String?
  avProvider            ProvidedBy?
  avNotes               String?
  fbNotes               String?
  decorNotes            String?
  securityNotes         String?
  signageNotes          String?
  shippingRequired      Boolean?
  customsRequired       Boolean?
  materialHandlingNotes String?
  electricalProvider    ProvidedBy?
  electricalNotes       String?
  utilitiesNotes        String?
  taxExempt             Boolean?
  taxExemptId           String?
  costCenter            String?
  billingNotes          String?
  sortOrder             Int                @default(0)
  equipmentItems        EquipmentItem[]
  updatedById           String?
  updatedBy             User?              @relation("ExhibitBoothUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([eventId])
  @@index([groupId])
  @@index([functionId])
  @@index([contactId])
  @@index([updatedById])
}

// APEX Post-Event Report (PER). Field meaning lives in src/lib/esg/perFields.ts;
// structured values are columns, comments are keys in `narrative`. Expected /
// actual attendance and membership live on Event.
model EventPostEvent {
  id      String @id @default(cuid())
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  naSections String[] @default([])
  narrative  Json     @default("{}")

  // §I Event information
  primaryFacilityType    String?
  offsiteVenueUsed       Boolean?
  onSiteRegistrations    Int?
  noShows                Int?
  exhibitorsAttending    Int?
  domesticAttendees      Int?
  internationalAttendees Int?
  shuttleProvided        Boolean?
  usedDmcPco             Boolean?
  guestPrograms          Boolean?
  // §III Hotel rooms (until the Hotels module supplies them)
  usedSleepingRooms      Boolean?
  hotelCount             Int?
  peakNightRooms         Int?
  housingPerformedBy     String?
  // §V Food & beverage
  icwFunctions           Boolean?
  // §VI Function space
  largestFunctionAvSetup String?
  extensiveAvRooms       Int?
  registrationAreas      Int?
  lounges                Int?
  offices                Int?
  moveInDays             Int?
  moveOutDays            Int?
  teardownDays           Int?
  // §VII Exhibit space
  gscUsed                Boolean?
  gscMoveInDays          Int?
  exhibitorsWithFb       Int?
  extensiveAvExhibitors  Int?
  // §VIII Future dates
  futureDatesConfirmed   Boolean?

  updatedById String?
  updatedBy   User?    @relation("EventPostEventUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
