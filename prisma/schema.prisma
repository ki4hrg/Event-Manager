// §S Shipping grid
model EventSpecShipment {
  id               String    @id @default(cuid())
  eventId          String
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromText         String?
  toText           String?
  shipper          String?
  itemCount        Int?
  expectedDelivery DateTime? @db.Date
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([eventId])
}

// §L Security / first-aid coverage schedule. kind: "SECURITY" | "FIRST_AID".
model EventSpecCoverage {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind      String
  location  String?
  startAt   DateTime?
  endAt     DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([eventId])
}

// §L Keys
model EventSpecKey {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location   String?
  functionId String?
  function   Function? @relation(fields: [functionId], references: [id], onDelete: SetNull)
  startAt    DateTime?
  endAt      DateTime?
  quantity   Int?
  rekeyed    Boolean   @default(false)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([eventId])
  @@index([functionId])
}

// Function numbers freed after the event's numbering was locked; never reused.
model RetiredFunctionNumber {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  number    String
  createdAt DateTime @default(now())

  @@unique([eventId, number])
}

// Stable per-room sub-number for a breakout block ("12" + "a" → "12a").
// Rows outlive a room's removal so a letter is never reassigned.
model FunctionRoomNumber {
  id         String   @id @default(cuid())
  functionId String
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  suffix     String
  createdAt  DateTime @default(now())

  @@unique([functionId, roomId])
  @@unique([functionId, suffix])
}

// ESG Part IIIb — one Booth Set-up Order per exhibit booth. Usually listed
// under the event's exhibit function (the master exhibit function); times
// left empty inherit from that function's schedules.
model ExhibitBooth {
  id                    String          @id @default(cuid())
  eventId               String
  event                 Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  functionId            String?
  function              Function?       @relation(fields: [functionId], references: [id], onDelete: SetNull)
  boothNumber           String?
  location              String?
  boothType             String?
  name                  String
  companyName           String?
  contactId             String?
  contact               Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  startAt               DateTime?
  endAt                 DateTime?
  setupBy               DateTime?
  teardownBy            DateTime?
  specialRequirements   String?
  setupNotes            String?
  avProvider            ProvidedBy?
  avNotes               String?
  fbNotes               String?
  decorNotes            String?
  securityNotes         String?
  signageNotes          String?
  shippingRequired      Boolean?
  customsRequired       Boolean?
  materialHandlingNotes String?
  electricalProvider    ProvidedBy?
  electricalNotes       String?
  utilitiesNotes        String?
  taxExempt             Boolean?
  taxExemptId           String?
  costCenter            String?
  billingNotes          String?
  sortOrder             Int             @default(0)
  equipmentItems        EquipmentItem[]
  updatedById           String?
  updatedBy             User?           @relation("ExhibitBoothUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([eventId])
  @@index([functionId])
  @@index([contactId])
  @@index([updatedById])
}
