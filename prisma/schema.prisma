model SetupOrder {
  id                String                   @id @default(cuid())
  name              String?
  setupType         String?
  status            EntityStatus?
  substatus         String?
  eventId           String
  event             Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
