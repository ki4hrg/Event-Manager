# NextAuth
NEXTAUTH_SECRET="change-this-to-a-secure-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Server
PORT=3000

# Mailgun (required for account invites and password reset)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="Event Manager <noreply@example.com>"
# Optional. Defaults to https://api.mailgun.net (US). Set to https://api.eu.mailgun.net for the EU region.
# MAILGUN_BASE_URL=https://api.mailgun.net

# Inbound email (event inboxes, `<org>.<event>@INBOUND_EMAIL_DOMAIN`). Both
# blank turns the inbox off. The secret is shared with the Cloudflare Email
# Worker in workers/email-inbound/ (generate with `openssl rand -hex 32`).
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=
# Claude API key for reading inbox mail (pickup reports). Blank leaves mail
# unread for staff to handle by hand.
ANTHROPIC_API_KEY=
