generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication
model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  password  String
  role      String        @default("user")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  settings  UserSetting[]
}

// Per-user key-value settings store
model UserSetting {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

enum EntityStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  CANCELLED
}

// Customizable options for dropdowns
model CustomOption {
  id        String   @id @default(cuid())
  category  String   // "function_type", "contact_role", "av_equipment", "equipment_category", "setup_type", "substatus"
  label     String   // The display label and stored value (e.g., "Meal / BEO", "Speaker")
  color     String?  // Optional color for badges (e.g., "orange", "blue")
  group     String?  // Optional grouping key; used by "substatus" category to tie options to an EntityStatus value
  isSystem  Boolean  @default(false) // System entries cannot be deleted from the UI
  sortOrder Int      @default(0)
  models    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, label])
  @@index([category])
}

// Equipment catalog with category grouping
model Equipment {
  id           String       @id @default(cuid())
  name         String
  category     String       // references equipment_category CustomOption label
  sortOrder    Int          @default(0)
  inputItems      InputItem[]      @relation("InputItemEquipment")
  monitorMixes    MonitorMix[]     @relation("MonitorMixEquipment")
  monitorOutputs  MonitorOutput[]  @relation("MonitorOutputEquipment")
  equipmentItems  EquipmentItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([category, name])
  @@index([category])
}

// Core entities
model Event {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  startDate          DateTime
  endDate            DateTime
  timezone           String              @default("America/Chicago")
  venueId            String?
  venue              Venue?              @relation(fields: [venueId], references: [id])
  functions          Function[]
  presentations      Presentation[]
  presentationTracks PresentationTrack[]
  breakoutGroups     BreakoutGroup[]
  avOrders           AVOrder[]
  cateringOrders     CateringOrder[]
  setupOrders        SetupOrder[]
  vendors            EventVendor[]
  files              FileUpload[]
  keyStaff           EventKeyStaff[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Venue {
  id         String         @id @default(cuid())
  name       String
  address    String?
  city       String?
  state      String?
  zip        String?
  country    String?
  notes      String?
  rooms      Room[]
  roomGroups RoomGroup[]
  events     Event[]
  contacts   VenueContact[]
  vendor     Vendor?
  files      FileUpload[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model RoomGroup {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
}

model Room {
  id                   String                        @id @default(cuid())
  name                 String
  capacity             Int?
  notes                String?
  venueId              String
  venue                Venue                         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  groupId              String?
  group                RoomGroup?                    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  functions            FunctionRoom[]
  presentationSlots    PresentationSlot[]
  breakoutGroupRooms   BreakoutGroupRoom[]
  sessionRoomOverrides BreakoutSessionRoomOverride[]
  setupOrders          SetupOrder[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@index([groupId])
}

// Flexible contact model with roles
model Contact {
  id            String                @id @default(cuid())
  firstName     String
  lastName      String
  email         String?
  phone         String?
  organization  String?
  notes         String?
  roles                  String[]              @default([])
  functions              FunctionContact[]
  venues                 VenueContact[]
  presentations          PresentationContact[]
  cateringOrders         CateringOrderContact[]
  vendorContacts         VendorContact[]
  inputGroupsAsProvider  InputGroup[]          @relation("InputGroupProviderContact")
  inputGroupsAsOperator  InputGroup[]          @relation("InputGroupOperatorContact")
  inputItemsAsProvider   InputItem[]           @relation("InputItemProviderContact")
  inputItemsAsOperator   InputItem[]           @relation("InputItemOperatorContact")
  monitorMixesAsProvider    MonitorMix[]          @relation("MonitorMixProviderContact")
  monitorMixesAsOperator    MonitorMix[]          @relation("MonitorMixOperatorContact")
  monitorOutputsAsProvider  MonitorOutput[]       @relation("MonitorOutputProviderContact")
  monitorOutputsAsOperator  MonitorOutput[]       @relation("MonitorOutputOperatorContact")
  mediaItemsAsAdvancer        MediaItem[]           @relation("MediaItemAdvancerContact")
  equipmentItemsAsProvider    EquipmentItem[]       @relation("EquipmentItemProviderContact")
  equipmentItemsAsOperator    EquipmentItem[]       @relation("EquipmentItemOperatorContact")
  eventKeyStaff               EventKeyStaff[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

// Junction table for Venue <-> Contact
model VenueContact {
  id        String  @id @default(cuid())
  venueId   String
  contactId String
  role      String? // e.g., "Sales Manager", "Event Coordinator"
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([venueId, contactId])
}

// Junction table for Event <-> Contact (key staff designations)
model EventKeyStaff {
  id        String   @id @default(cuid())
  eventId   String
  contactId String
  title     String?
  models    String[]
  sortOrder Int      @default(0)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([eventId, contactId, title])
}

// Function is the core scheduling unit
model Function {
  id                String             @id @default(cuid())
  name              String
  description       String?
  type              String             @default("")
  notes             String?
  offSiteLocation   String?
  status            EntityStatus?
  substatus         String?
  eventId           String
  breakoutGroupId   String?
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  breakoutGroup     BreakoutGroup?     @relation(fields: [breakoutGroupId], references: [id], onDelete: SetNull)
  avOrderId            String?
  avOrder              AVOrder?           @relation(fields: [avOrderId], references: [id], onDelete: SetNull)
  setupOrderId         String?
  setupOrder           SetupOrder?        @relation(fields: [setupOrderId], references: [id], onDelete: SetNull)
  rooms                FunctionRoom[]
  contacts             FunctionContact[]
  schedules            FunctionSchedule[]
  presentationSlots    PresentationSlot[]
  sessionRoomOverrides BreakoutSessionRoomOverride[]
  cateringOrder        CateringOrder?
  timelineItems        TimelineItem[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([eventId])
  @@index([breakoutGroupId])
  @@index([setupOrderId])
}

// Schedule items for a function (setup, rehearsal, main event, etc.)
model FunctionSchedule {
  id         String   @id @default(cuid())
  functionId String
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  type       String   // From CustomOption category "schedule_type"
  startTime  DateTime
  endTime    DateTime
  notes      String?
  isPublic   Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([functionId])
}

// Junction table for Function <-> Room (many-to-many)
model FunctionRoom {
  id         String   @id @default(cuid())
  functionId String
  roomId     String
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([functionId, roomId])
}

// Junction table for Function <-> Contact (many-to-many)
model FunctionContact {
  id         String   @id @default(cuid())
  functionId String
  contactId  String
  role       String? // e.g., "Presenter", "Moderator", "Panelist"
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([functionId, contactId])
}

model AVOrder {
  id             String        @id @default(cuid())
  name           String
  status         EntityStatus?
  substatus      String?
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  presentationId String?       @unique
  presentation   Presentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  copiedFromId   String?
  copiedFrom     AVOrder?      @relation("AVOrderCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies         AVOrder[]     @relation("AVOrderCopies")
  notes          String?
  functions      Function[]
  audioSection   AudioSection?
  videoSection   VideoSection?
  equipmentItems EquipmentItem[]
  vendors        AVOrderVendor[]
  files          FileUpload[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([eventId])
  @@index([copiedFromId])
}

model CateringOrder {
  id                 String                    @id @default(cuid())
  name               String
  status             EntityStatus?
  substatus          String?
  eventId            String
  event              Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  functionId         String?                   @unique
  function           Function?                 @relation(fields: [functionId], references: [id], onDelete: SetNull)
  serviceStyle       String?
  expectedCount      Int?
  confirmedCount     Int?
  guaranteeCount     Int?
  staffingNotes      String?
  rentalMinimum      Decimal?
  fbMinimum          Decimal?
  depositDeadline    DateTime?
  guaranteeDeadline  DateTime?
  paymentDeadline    DateTime?
  cancellationTerms  String?
  dietaryNotes       String?
  notes              String?
  timelineItems      TimelineItem[]
  equipmentItems     EquipmentItem[]
  lineItems          CateringOrderLineItem[]
  menuSections       CateringOrderMenuSection[]
  contacts           CateringOrderContact[]
  vendors            CateringOrderVendor[]
  files              FileUpload[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@map("BEO")
  @@index([eventId])
}

model TimelineItem {
  id         String    @id @default(cuid())
  cateringOrderId String?
  functionId      String?
  cateringOrder   CateringOrder? @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  function        Function?      @relation(fields: [functionId], references: [id], onDelete: Cascade)
  label      String
  startTime  DateTime
  endTime    DateTime?
  notes      String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([cateringOrderId])
  @@index([functionId])
}

model EquipmentItem {
  id                       String        @id @default(cuid())
  cateringOrderId          String?
  setupOrderId             String?
  videoSectionId           String?
  avOrderId                String?
  cateringOrder            CateringOrder? @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  setupOrder               SetupOrder?   @relation(fields: [setupOrderId], references: [id], onDelete: Cascade)
  videoSection             VideoSection? @relation(fields: [videoSectionId], references: [id], onDelete: Cascade)
  avOrder                  AVOrder?      @relation(fields: [avOrderId], references: [id], onDelete: Cascade)
  equipmentId              String?
  equipment                Equipment?    @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  item                     String
  quantity                 Int?
  providerVendorId         String?
  providerVendor           Vendor?       @relation("EquipmentItemProviderVendor", fields: [providerVendorId], references: [id], onDelete: SetNull)
  providerContactId        String?
  providerContact          Contact?      @relation("EquipmentItemProviderContact", fields: [providerContactId], references: [id], onDelete: SetNull)
  operatorVendorId         String?
  operatorVendor           Vendor?       @relation("EquipmentItemOperatorVendor", fields: [operatorVendorId], references: [id], onDelete: SetNull)
  operatorContactId        String?
  operatorContact          Contact?      @relation("EquipmentItemOperatorContact", fields: [operatorContactId], references: [id], onDelete: SetNull)
  notes                    String?
  sortOrder                Int           @default(0)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([cateringOrderId])
  @@index([setupOrderId])
  @@index([videoSectionId])
  @@index([avOrderId])
  @@index([equipmentId])
  @@index([providerVendorId])
  @@index([providerContactId])
  @@index([operatorVendorId])
  @@index([operatorContactId])
}

model SetupOrder {
  id             String          @id @default(cuid())
  name           String?
  setupType      String?
  status         EntityStatus?
  substatus      String?
  eventId        String
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roomId         String?
  room           Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  functions      Function[]
  presentationId String?       @unique
  presentation   Presentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  notes          String?
  tables         SetupTable[]
  equipmentItems EquipmentItem[]
  vendors        SetupOrderVendor[]
  files          FileUpload[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([eventId])
  @@index([roomId])
}

model SetupTable {
  id           String     @id @default(cuid())
  setupOrderId String
  setupOrder   SetupOrder @relation(fields: [setupOrderId], references: [id], onDelete: Cascade)
  quantity     Int
  tableType    String?
  chairCount   Int?
  chairType    String?
  notes        String?
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([setupOrderId])
}

model CateringOrderLineItem {
  id              String        @id @default(cuid())
  cateringOrderId String        @map("beoId")
  cateringOrder   CateringOrder @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  description     String
  unitType        String?
  unitPrice       Decimal?
  quantity        Int?
  notes           String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("BEOLineItem")
  @@index([cateringOrderId])
}

model CateringOrderMenuSection {
  id                       String        @id @default(cuid())
  cateringOrderId          String        @map("beoId")
  cateringOrder            CateringOrder @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  responsiblePartyVendorId String?
  responsiblePartyVendor   Vendor?       @relation("MenuSectionResponsibleVendor", fields: [responsiblePartyVendorId], references: [id], onDelete: SetNull)
  menuContent              String
  notes                    String?
  sortOrder                Int           @default(0)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@map("BEOMenuSection")
  @@index([cateringOrderId])
  @@index([responsiblePartyVendorId])
}

model CateringOrderContact {
  id              String        @id @default(cuid())
  cateringOrderId String        @map("beoId")
  contactId       String
  role            String?
  cateringOrder   CateringOrder @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("BEOContact")
  @@unique([cateringOrderId, contactId])
}

// Presentation tracks (scoped per event)
model PresentationTrack {
  id            String         @id @default(cuid())
  name          String
  color         String?
  sortOrder     Int            @default(0)
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  presentations Presentation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([eventId, name])
  @@index([eventId])
}

// Breakout session groups (scoped per event)
model BreakoutGroup {
  id            String              @id @default(cuid())
  name          String
  sortOrder     Int                 @default(0)
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  functions     Function[]
  rooms         BreakoutGroupRoom[]
  presentations Presentation[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([eventId])
}

// Junction: BreakoutGroup <-> Room (group-level room assignment)
model BreakoutGroupRoom {
  id              String        @id @default(cuid())
  breakoutGroupId String
  roomId          String
  breakoutGroup   BreakoutGroup @relation(fields: [breakoutGroupId], references: [id], onDelete: Cascade)
  room            Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([breakoutGroupId, roomId])
}

// Per-session room overrides (exclude a group room or include a non-group room)
model BreakoutSessionRoomOverride {
  id         String   @id @default(cuid())
  functionId String
  roomId     String
  type       String   // "exclude" or "include"
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([functionId, roomId])
}

// Junction: BREAKOUT_BLOCK function <-> Presentation, with optional room assignment
model PresentationSlot {
  id             String       @id @default(cuid())
  functionId     String
  presentationId String
  roomId         String?
  function       Function     @relation(fields: [functionId], references: [id], onDelete: Cascade)
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  room           Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@unique([functionId, presentationId])
  @@index([presentationId])
}

// Presentation models for breakout sessions
model Presentation {
  id              String                @id @default(cuid())
  title           String
  type            String                @default("")
  status          EntityStatus?
  substatus       String?
  description     String?
  schedulingNotes String?               @map("notes")
  internalNotes   String?
  instanceCount   Int                   @default(1)
  trackId         String?
  track           PresentationTrack?    @relation(fields: [trackId], references: [id], onDelete: SetNull)
  breakoutGroupId String?
  breakoutGroup   BreakoutGroup?        @relation(fields: [breakoutGroupId], references: [id], onDelete: SetNull)
  eventId         String
  event           Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speakers        PresentationContact[]
  slots           PresentationSlot[]
  avOrder         AVOrder?
  setupOrder      SetupOrder?
  mediaItems      MediaItem[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([eventId])
  @@index([trackId])
  @@index([breakoutGroupId])
}

model PresentationContact {
  id             String       @id @default(cuid())
  presentationId String
  contactId      String
  role           String?      // "Presenter", "Co-Presenter", "Moderator", "Panelist"
  isPrimary      Boolean      @default(false)
  sortOrder      Int          @default(0)
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([presentationId, contactId])
  @@index([presentationId])
}

// Workflow system — hierarchical templates with sequential steps and optional checklist sub-items

model WorkflowTemplate {
  id                       String             @id @default(cuid())
  name                     String
  description              String?
  sortOrder                Int                @default(0)
  defaultForEntityTypes    String[]           @default([])
  pendingStatusValue       EntityStatus?      // status applied when assigned but no steps completed yet
  pendingSubstatusValue    String?
  completionStatusValue    EntityStatus?      // status applied when all steps in this workflow are complete
  completionSubstatusValue String?
  steps                    WorkflowStep[]
  instances                WorkflowInstance[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
}

model WorkflowStep {
  id                    String                   @id @default(cuid())
  templateId            String
  template              WorkflowTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label                 String
  sortOrder             Int                      @default(0)
  computedKey           String?                  // reserved for future auto-derived checks (e.g., "HAS_ROOMS")
  pendingStatusValue    EntityStatus?            // status applied while this step is the current (first incomplete) step
  pendingSubstatusValue String?
  items                 WorkflowChecklistItem[]
  completions           WorkflowStepCompletion[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([templateId])
}

model WorkflowChecklistItem {
  id          String                       @id @default(cuid())
  stepId      String
  step        WorkflowStep                 @relation(fields: [stepId], references: [id], onDelete: Cascade)
  label       String
  sortOrder   Int                          @default(0)
  computedKey String?                      // reserved for future auto-derived checks
  completions WorkflowChecklistCompletion[]
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([stepId])
}

// Links a workflow template to a specific entity (CateringOrder, Function, AVOrder, etc.)
model WorkflowInstance {
  id              String                       @id @default(cuid())
  templateId      String
  template        WorkflowTemplate             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  entityType      String                       // "function", "catering_order", "av_order", "presentation"
  entityId        String
  stepCompletions WorkflowStepCompletion[]
  itemCompletions WorkflowChecklistCompletion[]
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@unique([templateId, entityType, entityId])
  @@index([entityType, entityId])
}

// Completion of a step — existence of this row means the step is complete
model WorkflowStepCompletion {
  id          String           @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId      String
  step        WorkflowStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  completedAt DateTime         @default(now())
  notes       String?

  @@unique([instanceId, stepId])
}

// Completion of a checklist item — existence of this row means the item is complete
model WorkflowChecklistCompletion {
  id          String                @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  itemId      String
  item        WorkflowChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  completedAt DateTime              @default(now())
  notes       String?

  @@unique([instanceId, itemId])
}

// Vendor management

model Vendor {
  id                        String                     @id @default(cuid())
  name                      String
  models                    String[]                   @default([]) // references ModelType values: CATERING_ORDER, AV_ORDER, SETUP_ORDER
  notes                     String?
  isSystemVendor            Boolean                    @default(false)
  venueId                   String?                    @unique
  venue                     Venue?                     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  contacts                  VendorContact[]
  eventVendors              EventVendor[]
  avOrderVendors            AVOrderVendor[]
  cateringOrderVendors      CateringOrderVendor[]
  setupOrderVendors         SetupOrderVendor[]
  equipmentItemsAsProvider  EquipmentItem[]            @relation("EquipmentItemProviderVendor")
  equipmentItemsAsOperator  EquipmentItem[]            @relation("EquipmentItemOperatorVendor")
  responsibleMenuSections   CateringOrderMenuSection[] @relation("MenuSectionResponsibleVendor")
  inputGroupsAsProvider     InputGroup[]               @relation("InputGroupProviderVendor")
  inputGroupsAsOperator     InputGroup[]               @relation("InputGroupOperatorVendor")
  inputItemsAsProvider      InputItem[]                @relation("InputItemProviderVendor")
  inputItemsAsOperator      InputItem[]                @relation("InputItemOperatorVendor")
  monitorMixesAsProvider      MonitorMix[]               @relation("MonitorMixProviderVendor")
  monitorMixesAsOperator      MonitorMix[]               @relation("MonitorMixOperatorVendor")
  monitorOutputsAsProvider    MonitorOutput[]            @relation("MonitorOutputProviderVendor")
  monitorOutputsAsOperator    MonitorOutput[]            @relation("MonitorOutputOperatorVendor")
  mediaItemsAsAdvancer      MediaItem[]                @relation("MediaItemAdvancerVendor")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

// Junction: Vendor <-> Contact
model VendorContact {
  id          String  @id @default(cuid())
  vendorId    String
  contactId   String
  contactType String? // from vendor_contact_type CustomOption
  isPrimary   Boolean @default(false)
  vendor      Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  contact     Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([vendorId, contactId])
}

// Junction: Event <-> Vendor (with optional default-per-model-type designation)
// Valid defaultFor values: "CATERING_ORDER", "AV_ORDER", "SETUP_ORDER"
// When a new document model with vendor support is added, add its identifier here
// and wire up auto-assignment in its create action.
model EventVendor {
  id         String   @id @default(cuid())
  eventId    String
  vendorId   String
  defaultFor String[] @default([])
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId])
  @@index([eventId])
}

// Junction: AVOrder <-> Vendor
model AVOrderVendor {
  id        String  @id @default(cuid())
  avOrderId String
  vendorId  String
  notes     String?
  avOrder   AVOrder @relation(fields: [avOrderId], references: [id], onDelete: Cascade)
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([avOrderId, vendorId])
  @@index([avOrderId])
}

// Junction: CateringOrder <-> Vendor
model CateringOrderVendor {
  id              String        @id @default(cuid())
  cateringOrderId String        @map("beoId")
  vendorId        String
  notes           String?
  cateringOrder   CateringOrder @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("BEOVendor")
  @@unique([cateringOrderId, vendorId])
  @@index([cateringOrderId])
}

// Junction: SetupOrder <-> Vendor
model SetupOrderVendor {
  id           String     @id @default(cuid())
  setupOrderId String
  vendorId     String
  notes        String?
  setupOrder   SetupOrder @relation(fields: [setupOrderId], references: [id], onDelete: Cascade)
  vendor       Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([setupOrderId, vendorId])
  @@index([setupOrderId])
}

// AV Order sub-models

model AudioSection {
  id           String       @id @default(cuid())
  avOrderId    String       @unique
  avOrder      AVOrder      @relation(fields: [avOrderId], references: [id], onDelete: Cascade)
  notes        String?
  inputGroups  InputGroup[]
  monitorMixes MonitorMix[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model InputGroup {
  id                String       @id @default(cuid())
  audioSectionId    String
  audioSection      AudioSection @relation(fields: [audioSectionId], references: [id], onDelete: Cascade)
  name              String       @default("Default")
  providerVendorId  String?
  providerVendor    Vendor?      @relation("InputGroupProviderVendor", fields: [providerVendorId], references: [id], onDelete: SetNull)
  providerContactId String?
  providerContact   Contact?     @relation("InputGroupProviderContact", fields: [providerContactId], references: [id], onDelete: SetNull)
  operatorVendorId  String?
  operatorVendor    Vendor?      @relation("InputGroupOperatorVendor", fields: [operatorVendorId], references: [id], onDelete: SetNull)
  operatorContactId String?
  operatorContact   Contact?     @relation("InputGroupOperatorContact", fields: [operatorContactId], references: [id], onDelete: SetNull)
  notes             String?
  sortOrder         Int          @default(0)
  inputItems        InputItem[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([audioSectionId])
}

model InputItem {
  id                String     @id @default(cuid())
  inputGroupId      String
  inputGroup        InputGroup @relation(fields: [inputGroupId], references: [id], onDelete: Cascade)
  description       String
  quantity          Int        @default(1)
  equipmentId       String?
  equipment         Equipment? @relation("InputItemEquipment", fields: [equipmentId], references: [id], onDelete: SetNull)
  providerVendorId  String?
  providerVendor    Vendor?    @relation("InputItemProviderVendor", fields: [providerVendorId], references: [id], onDelete: SetNull)
  providerContactId String?
  providerContact   Contact?   @relation("InputItemProviderContact", fields: [providerContactId], references: [id], onDelete: SetNull)
  operatorVendorId  String?
  operatorVendor    Vendor?    @relation("InputItemOperatorVendor", fields: [operatorVendorId], references: [id], onDelete: SetNull)
  operatorContactId String?
  operatorContact   Contact?   @relation("InputItemOperatorContact", fields: [operatorContactId], references: [id], onDelete: SetNull)
  notes             String?
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([inputGroupId])
  @@index([equipmentId])
}

model MonitorMix {
  id                String          @id @default(cuid())
  audioSectionId    String
  audioSection      AudioSection    @relation(fields: [audioSectionId], references: [id], onDelete: Cascade)
  description       String
  equipmentId       String?
  equipment         Equipment?      @relation("MonitorMixEquipment", fields: [equipmentId], references: [id], onDelete: SetNull)
  providerVendorId  String?
  providerVendor    Vendor?         @relation("MonitorMixProviderVendor", fields: [providerVendorId], references: [id], onDelete: SetNull)
  providerContactId String?
  providerContact   Contact?        @relation("MonitorMixProviderContact", fields: [providerContactId], references: [id], onDelete: SetNull)
  operatorVendorId  String?
  operatorVendor    Vendor?         @relation("MonitorMixOperatorVendor", fields: [operatorVendorId], references: [id], onDelete: SetNull)
  operatorContactId String?
  operatorContact   Contact?        @relation("MonitorMixOperatorContact", fields: [operatorContactId], references: [id], onDelete: SetNull)
  notes             String?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  monitorOutputs    MonitorOutput[]

  @@index([audioSectionId])
  @@index([equipmentId])
}

model MonitorOutput {
  id                String       @id @default(cuid())
  monitorMixId      String
  monitorMix        MonitorMix   @relation(fields: [monitorMixId], references: [id], onDelete: Cascade)
  equipmentId       String?
  equipment         Equipment?   @relation("MonitorOutputEquipment", fields: [equipmentId], references: [id], onDelete: SetNull)
  quantity          Int          @default(1)
  providerVendorId  String?
  providerVendor    Vendor?      @relation("MonitorOutputProviderVendor", fields: [providerVendorId], references: [id], onDelete: SetNull)
  providerContactId String?
  providerContact   Contact?     @relation("MonitorOutputProviderContact", fields: [providerContactId], references: [id], onDelete: SetNull)
  operatorVendorId  String?
  operatorVendor    Vendor?      @relation("MonitorOutputOperatorVendor", fields: [operatorVendorId], references: [id], onDelete: SetNull)
  operatorContactId String?
  operatorContact   Contact?     @relation("MonitorOutputOperatorContact", fields: [operatorContactId], references: [id], onDelete: SetNull)
  notes             String?
  sortOrder         Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([monitorMixId])
  @@index([equipmentId])
}

model VideoSection {
  id             String          @id @default(cuid())
  avOrderId      String          @unique
  avOrder        AVOrder         @relation(fields: [avOrderId], references: [id], onDelete: Cascade)
  notes          String?
  equipmentItems EquipmentItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model MediaItem {
  id                String       @id @default(cuid())
  presentationId    String
  presentation      Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  description       String
  delivery          String?      // references delivery_method CustomOption
  advancerVendorId  String?
  advancerVendor    Vendor?      @relation("MediaItemAdvancerVendor", fields: [advancerVendorId], references: [id], onDelete: SetNull)
  advancerContactId String?
  advancerContact   Contact?     @relation("MediaItemAdvancerContact", fields: [advancerContactId], references: [id], onDelete: SetNull)
  notes             String?
  sortOrder         Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([presentationId])
}

model FileUpload {
  id              String         @id @default(cuid())
  fileName        String
  storedName      String
  mimeType        String
  fileSize        Int
  fileType        String?

  eventId         String?
  event           Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  cateringOrderId String?
  cateringOrder   CateringOrder? @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  avOrderId       String?
  avOrder         AVOrder?       @relation(fields: [avOrderId], references: [id], onDelete: Cascade)
  setupOrderId    String?
  setupOrder      SetupOrder?    @relation(fields: [setupOrderId], references: [id], onDelete: Cascade)
  venueId         String?
  venue           Venue?         @relation(fields: [venueId], references: [id], onDelete: Cascade)

  createdAt       DateTime       @default(now())

  @@index([eventId])
  @@index([cateringOrderId])
  @@index([avOrderId])
  @@index([setupOrderId])
  @@index([venueId])
}
