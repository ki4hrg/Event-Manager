generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication
model User {
  id                         String                   @id @default(cuid())
  email                      String                   @unique
  name                       String?
  // Nullable: new users start without a password until they consume an invite token.
  password                   String?
  // Platform administrator: may create tenants, manage every tenant's
  // memberships, and carries every permission in every tenant. Deliberately a
  // flag rather than a Role — roles are tenant memberships, and a super admin
  // needs to act before any membership exists.
  isSuperAdmin               Boolean                  @default(false)
  // Shows diagnostics (raw .eml, mail authentication results, parser errors)
  // to someone who isn't a super admin. Set by super admins on the user page.
  showDiagnostics            Boolean                  @default(false)
  // Which tenants this user may enter, and with what role in each. A user's
  // permissions are always resolved through the membership for the tenant in
  // question — there is no global role anymore.
  memberships                TenantMembership[]
  inboundEmailsHandled       InboundEmail[]           @relation("InboundEmailHandledBy")
  // Self-ref for "last updated by" attribution.
  updatedById                String?
  updatedBy                  User?                    @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatesByUser              User[]                   @relation("UserUpdatedBy")
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  settings                   UserSetting[]
  shareLinks                 ShareLink[]
  shareLinkGroups            ShareLinkGroup[]
  formLinksCreated           FormLink[]               @relation("FormLinkCreatedBy")
  formSubmissionsHandled     FormSubmission[]         @relation("FormSubmissionHandledBy")
  speakerProfilesUpdated     SpeakerProfile[]         @relation("SpeakerProfileUpdatedBy")
  passwordResetTokens        PasswordResetToken[]
  staffAssignments           EventStaff[]
  // Inverse relations for "last updated by" attribution across all editable entities.
  updatedEvents              Event[]                  @relation("EventUpdatedBy")
  updatedEventSpecifications EventSpecification[]     @relation("EventSpecificationUpdatedBy")
  updatedExhibitBooths       ExhibitBooth[]           @relation("ExhibitBoothUpdatedBy")
  updatedHotelProposals      HotelProposal[]          @relation("HotelProposalUpdatedBy")
  updatedRfps                Rfp[]                    @relation("RfpUpdatedBy")
  updatedVendorQuotes        VendorQuote[]            @relation("VendorQuoteUpdatedBy")
  updatedHotelBlocks         HotelBlock[]             @relation("HotelBlockUpdatedBy")
  hotelPickupImports         HotelPickupImport[]
  hotelProposalVersions      HotelProposalVersion[]
  updatedExhibitBoothGroups  ExhibitBoothGroup[]      @relation("ExhibitBoothGroupUpdatedBy")
  updatedPostEvents          EventPostEvent[]         @relation("EventPostEventUpdatedBy")
  updatedVenues              Venue[]                  @relation("VenueUpdatedBy")
  updatedContacts            Contact[]                @relation("ContactUpdatedBy")
  updatedVendors             Vendor[]                 @relation("VendorUpdatedBy")
  updatedFunctions           Function[]               @relation("FunctionUpdatedBy")
  updatedPresentations       Presentation[]           @relation("PresentationUpdatedBy")
  updatedCateringOrders      CateringOrder[]          @relation("CateringOrderUpdatedBy")
  updatedAVOrders            AVOrder[]                @relation("AVOrderUpdatedBy")
  updatedSetupOrders         SetupOrder[]             @relation("SetupOrderUpdatedBy")
  updatedPrintOrders         PrintOrder[]             @relation("PrintOrderUpdatedBy")
  updatedSupplyOrders        SupplyOrder[]            @relation("SupplyOrderUpdatedBy")
  updatedMediaDeliverables   MediaDeliverable[]       @relation("MediaDeliverableUpdatedBy")
  updatedWorkflowTemplates   WorkflowTemplate[]       @relation("WorkflowTemplateUpdatedBy")
  updatedRoles               Role[]                   @relation("RoleUpdatedBy")
  apiKeys                    ApiKey[]
  oauthAuthorizationCodes    OAuthAuthorizationCode[]
  oauthRefreshTokens         OAuthRefreshToken[]
}

// Multi-tenancy. A Tenant owns every domain row (events, venues, contacts,
// vendors, catalogs, dropdown options); Users and Roles are global so one login
// can belong to several tenants with a different role in each.
model Tenant {
  id                String             @id @default(cuid())
  name              String
  // URL-safe handle used by the MCP `tenant` argument and shown in the switcher.
  slug              String             @unique
  // Organization profile. Defaults for the ESG §A host-organization fields
  // when an event's specification leaves them blank.
  phone             String?
  website           String?
  address1          String?
  address2          String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  // HTML from RichTextEditor.
  overview          String?
  memberships       TenantMembership[]
  events            Event[]
  eventSeries       EventSeries[]
  venues            Venue[]
  contacts          Contact[]
  vendors           Vendor[]
  customOptions     CustomOption[]
  equipment         Equipment[]
  storageLocations  StorageLocation[]
  inventoryItems    InventoryItem[]
  workflowTemplates WorkflowTemplate[]
  inboundEmails     InboundEmail[]
  formLinks         FormLink[]
  formSubmissions   FormSubmission[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// Junction: which Users may enter which Tenant, and the Role they hold there.
model TenantMembership {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([roleId])
}

// Bearer tokens for programmatic access via the MCP connector (/mcp).
// hashedKey is SHA-256 of the full key (not bcrypt — keys are high-entropy randoms,
// indexed lookup, single hash per request). keyPrefix is the plaintext first ~8
// chars so admins can identify a key in the UI without revealing the secret.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String
  hashedKey  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

// OAuth 2.1 authorization-server tables backing the remote MCP connector
// (claude.ai web/mobile custom connectors). The hand-rolled OAuth endpoints live
// under src/app/api/oauth/*; access tokens are HS256 JWTs (see src/lib/mcpOAuth.ts)
// that the MCP route verifies without a DB round-trip. These tables only persist
// the registration, the short-lived authorization code, and the refresh-token
// rotation family. API-key auth (ApiKey above) remains supported in parallel.

// A dynamically-registered OAuth client (RFC 7591). claude.ai self-registers
// anonymously via /api/oauth/register. PKCE is the only client authentication
// (token_endpoint_auth_method = "none"); no client secret is issued.
model OAuthClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique @default(cuid())
  clientSecret            String?
  clientName              String?
  redirectUris            String[]
  grantTypes              String[] @default(["authorization_code", "refresh_token"])
  responseTypes           String[] @default(["code"])
  tokenEndpointAuthMethod String   @default("none")
  createdAt               DateTime @default(now())
}

// A single-use authorization code (10-minute TTL). codeChallenge is the S256
// PKCE challenge; usedAt is stamped on redemption to block replay.
model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  code                String    @unique @default(cuid())
  clientId            String
  userId              String
  // Cascade so deleting a user tears down their outstanding grants with them,
  // matching ApiKey / PasswordResetToken. Without the FK a deleted user left
  // orphan rows behind (inert, but they never got collected).
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  scope               String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime  @default(now())

  @@index([code])
  @@index([userId])
  @@index([expiresAt])
}

// A rotating refresh token (30-day TTL). Only the SHA-256 hash is stored.
// familyId groups a rotation lineage: presenting a revoked token from a family
// is treated as theft and revokes the whole family. replacedById points at the
// token that superseded this one on rotation.
model OAuthRefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  familyId     String
  clientId     String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope        String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
}

// One-time tokens used for both initial invite and password reset flows.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// Per-user key-value settings store
model UserSetting {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

enum EntityStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  CANCELLED
}

enum StatusModelType {
  FUNCTION
  PRESENTATION
  AV_ORDER
  CATERING_ORDER
  SETUP_ORDER
  PRINT_ORDER
  MEDIA_DELIVERABLE
  SUPPLY_ORDER
  FORM_SUBMISSION
}

enum AcquisitionState {
  ON_HAND
  TO_PROCURE
  DROP_SHIP
}

enum PackingStatus {
  NEEDED
  IN_TRANSIT
  DELIVERED
}

// PLACE nodes are fixed (a building, a shelf); CONTAINER nodes travel to the
// venue and are packed as a unit. Only this distinction is hard-coded — the
// display taxonomy (Pallet, Tote, Trailer...) is a location_type CustomOption.
enum LocationKind {
  PLACE
  CONTAINER
}

// Customizable options for dropdowns
model CustomOption {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  String // "function_type", "contact_role", "av_equipment", "equipment_category", "setup_type", "substatus"
  label     String // The display label and stored value (e.g., "Meal / BEO", "Speaker")
  color     String? // Optional color for badges (e.g., "orange", "blue")
  group     String? // Optional grouping key; used by "substatus" category to tie options to an EntityStatus value
  isSystem  Boolean  @default(false) // System entries cannot be deleted from the UI
  sortOrder Int      @default(0)
  models    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, category, label])
  @@index([tenantId])
  @@index([category])
}

// Equipment catalog with category grouping
model Equipment {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  category         String // references equipment_category CustomOption label
  sortOrder        Int               @default(0)
  inputItems       InputItem[]       @relation("InputItemEquipment")
  monitorMixes     MonitorMix[]      @relation("MonitorMixEquipment")
  monitorOutputs   MonitorOutput[]   @relation("MonitorOutputEquipment")
  equipmentItems   EquipmentItem[]
  supplyOrderItems SupplyOrderItem[]
  inventoryItems   InventoryItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([tenantId, category, name])
  @@index([tenantId])
  @@index([category])
}

// Global, durable catalog of where things live: Off-Site Storage -> Logistics
// Pallet -> Registration Box. `parentId` is the durable home. A CONTAINER's
// placement for a given event is the per-event override carried on its
// SupplyOrderItem container line (SupplyOrderItem.sourceLocationId), so the
// effective parent is `containerLine.sourceLocationId ?? parentId`.
//
// The tree encodes home, not current whereabouts — a box on a truck still sits
// under Off-Site Storage here. Where it is right now is the container line's
// packingStatus.
model StorageLocation {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  kind      LocationKind      @default(PLACE)
  type      String? // references a location_type CustomOption label
  parentId  String?
  parent    StorageLocation?  @relation("StorageLocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  StorageLocation[] @relation("StorageLocationTree")
  notes     String?
  sortOrder Int               @default(0)
  archived  Boolean           @default(false)

  sourcedSupplyItems   SupplyOrderItem[] @relation("SupplyItemSourceLocation")
  containerSupplyItems SupplyOrderItem[] @relation("SupplyItemContainer")
  sourcedPrintItems    PrintItem[]       @relation("PrintItemSourceLocation")
  inventoryItems       InventoryItem[]   @relation("InventoryItemLocation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([parentId])
  @@index([kind])
}

// What durably lives at a StorageLocation between events. The tree above is
// *where*; this is *what's in it*. Deliberately coarse — one row per line you
// would write on a packing list — with a single home and no per-event state.
// Splitting one quantity across locations is out of scope, so two boxes of
// lanyards are two rows, not one row with a placement table.
model InventoryItem {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Inventory is catalogued gear, so the Equipment link is the item's identity
  // and `name` is only a qualifier — "blue", "spare", "left case". Requiring the
  // link is what makes stock answerable across locations ("how many easels do we
  // own, and where?"), which free text can't do.
  name        String?
  equipmentId String
  // Restrict rather than SetNull now that the link can't be absent: deleting an
  // Equipment row that is inventoried somewhere should be blocked, not silently
  // orphan the inventory record.
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  quantity    Int?
  notes       String?
  // Packers carry WRITE but not DELETE, so archiving is their retire path for a
  // consumed item — the same split the location tree itself uses.
  archived    Boolean   @default(false)
  sortOrder   Int       @default(0)

  // Restrict, not SetNull: the tree promotes orphaned child *locations* to roots,
  // but an inventory item without a location is meaningless, and Cascade would
  // silently destroy a box's contents behind a confirm that only warns about
  // child locations. deleteStorageLocationCore pre-checks so the user gets a
  // sentence rather than a foreign key error.
  locationId String
  location   StorageLocation @relation("InventoryItemLocation", fields: [locationId], references: [id], onDelete: Restrict)

  supplyOrderItems SupplyOrderItem[] @relation("SupplyItemInventoryItem")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@index([equipmentId])
}

// Core entities

// Groups the recurring editions of one conference (2024/2025/2026) so the app can
// answer "the previous event in this series" — for the import source default and
// for granting a venue rep access to every prior year in one action.
model EventSeries {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Event {
  id                      String                       @id @default(cuid())
  tenantId                String
  tenant                  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                    String
  description             String?
  startDate               DateTime
  endDate                 DateTime
  timezone                String                       @default("America/Chicago")
  seriesId                String?
  series                  EventSeries?                 @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  venues                  EventVenue[]
  functions               Function[]
  presentations           Presentation[]
  presentationTracks      PresentationTrack[]
  breakoutGroups          BreakoutGroup[]
  avOrders                AVOrder[]
  cateringOrders          CateringOrder[]
  setupOrders             SetupOrder[]
  printOrders             PrintOrder[]
  supplyOrders            SupplyOrder[]
  mediaDeliverables       MediaDeliverable[]
  vendors                 EventVendor[]
  shareLinks              ShareLink[]
  shareLinkGroups         ShareLinkGroup[]
  formLinks               FormLink[]
  formSubmissions         FormSubmission[]
  speakerProfiles         SpeakerProfile[]
  files                   FileUpload[]
  keyStaff                EventKeyStaff[]
  statusDefaults          EventStatusDefault[]
  staff                   EventStaff[]
  // Membership is the eligible/theoretical maximum for membership-based events;
  // attendance is tracked separately (expected for the ESG, actual for the PER).
  isMembershipBased       Boolean                      @default(false)
  membershipCount         Int?
  expectedAttendance      Int?
  actualAttendance        Int?
  // Where the event looks for hotels (and reports by area): whole regions
  // (hotel_region labels) and single areas (hotel_area labels). Hotel RFPs
  // use these unless they set their own.
  regions                 String[]                     @default([])
  areas                   String[]                     @default([])
  functionNumbersLockedAt DateTime?
  specification           EventSpecification?
  specVips                EventSpecVip[]
  specShuttleRoutes       EventSpecShuttleRoute[]
  specTransfers           EventSpecTransfer[]
  specShipments           EventSpecShipment[]
  specCoverage            EventSpecCoverage[]
  specKeys                EventSpecKey[]
  retiredFunctionNumbers  RetiredFunctionNumber[]
  exhibitBooths           ExhibitBooth[]
  hotelProposals          HotelProposal[]
  rfps                    Rfp[]
  vendorQuotes            VendorQuote[]
  // Local part of the event's inbox address, `<tenant.slug>.<inboxSlug>@<domain>`
  // (see docs/proposals/email-ingest.md). Null: no inbox.
  inboxSlug               String?
  inboundEmails           InboundEmail[]
  exhibitBoothGroups      ExhibitBoothGroup[]
  postEvent               EventPostEvent?
  postEventFutureDates    EventPostEventFutureDate[]
  postEventDistributions  EventPostEventDistribution[]
  updatedById             String?
  updatedBy               User?                        @relation("EventUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  @@unique([tenantId, inboxSlug])
  @@index([tenantId])
  @@index([updatedById])
  @@index([seriesId])
}

model Venue {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  city           String?
  state          String?
  zip            String?
  country        String?
  notes          String?
  // Hotels module: a venue that sells sleeping rooms. brand / area are
  // hotel_brand / hotel_area option labels (an area's group is its region).
  isLodging      Boolean         @default(false)
  brand          String?
  area           String?
  // hotel_amenity option labels: what the property has or provides as a
  // matter of course (shuttle, restaurant, complimentary breakfast). The
  // hotel's profile, filtered on when choosing RFP recipients.
  amenities      String[]        @default([])
  hotelProposals HotelProposal[]
  rfpRecipients  RfpRecipient[]
  rooms          Room[]
  roomGroups     RoomGroup[]
  events         EventVenue[]
  contacts       VenueContact[]
  vendor         Vendor?
  files          FileUpload[]
  updatedById    String?
  updatedBy      User?           @relation("VenueUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId])
  @@index([updatedById])
}

// Event <-> Venue. An event may span several venues (conference hotel plus an
// offsite dinner venue, a second hotel for overflow). The venue at the lowest
// sortOrder is the event's primary venue — the one shown as its headline and
// used when a single venue is needed. Keeping "primary" as a position rather
// than a flag means there is no "exactly one primary" invariant to maintain:
// deleting the primary venue promotes the next one automatically.
model EventVenue {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([eventId, venueId])
  @@index([venueId])
}

model RoomGroup {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
}

model Room {
  id                   String                        @id @default(cuid())
  name                 String
  capacity             Int?
  notes                String?
  venueId              String
  venue                Venue                         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  groupId              String?
  group                RoomGroup?                    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  functions            FunctionRoom[]
  presentationSlots    PresentationSlot[]
  breakoutGroupRooms   BreakoutGroupRoom[]
  sessionRoomOverrides BreakoutSessionRoomOverride[]
  setupOrders          SetupOrder[]
  supplyOrders         SupplyOrder[]
  printOrders          PrintOrder[]
  functionRoomNumbers  FunctionRoomNumber[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@index([groupId])
}

// Flexible contact model with roles
model Contact {
  id                          String                    @id @default(cuid())
  leadSourceFor               HotelProposal[]           @relation("HotelProposalLeadSourceContact")
  tenantId                    String
  tenant                      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName                   String
  lastName                    String
  email                       String?
  phone                       String?
  organization                String?
  notes                       String?
  roles                       String[]                  @default([])
  functions                   FunctionContact[]
  venues                      VenueContact[]
  presentations               PresentationContact[]
  cateringOrders              CateringOrderContact[]
  mediaDeliverableContacts    MediaDeliverableContact[]
  mediaDeliverablesAsProvider MediaDeliverable[]        @relation("MediaDeliverableProviderContact")
  vendorContacts              VendorContact[]
  printItemsAsDesigner        PrintItem[]               @relation("PrintItemDesignerContact")
  printItemsAsPrinter         PrintItem[]               @relation("PrintItemPrinterContact")
  inputGroupsAsProvider       InputGroup[]              @relation("InputGroupProviderContact")
  inputGroupsAsOperator       InputGroup[]              @relation("InputGroupOperatorContact")
  inputItemsAsProvider        InputItem[]               @relation("InputItemProviderContact")
  inputItemsAsOperator        InputItem[]               @relation("InputItemOperatorContact")
  monitorMixesAsProvider      MonitorMix[]              @relation("MonitorMixProviderContact")
  monitorMixesAsOperator      MonitorMix[]              @relation("MonitorMixOperatorContact")
  monitorOutputsAsProvider    MonitorOutput[]           @relation("MonitorOutputProviderContact")
  monitorOutputsAsOperator    MonitorOutput[]           @relation("MonitorOutputOperatorContact")
  presentationsAsAdvancer     Presentation[]            @relation("PresentationAdvancerContact")
  presentationSlotsAsAdvancer PresentationSlot[]        @relation("PresentationSlotAdvancerContact")
  equipmentItemsAsProvider    EquipmentItem[]           @relation("EquipmentItemProviderContact")
  equipmentItemsAsOperator    EquipmentItem[]           @relation("EquipmentItemOperatorContact")
  supplyOrdersAsProvider      SupplyOrder[]             @relation("SupplyOrderProviderContact")
  supplyOrderItemsAsProvider  SupplyOrderItem[]         @relation("SupplyOrderItemProviderContact")
  eventKeyStaff               EventKeyStaff[]
  specFinalBillFor            EventSpecification[]      @relation("SpecFinalBillContact")
  specVips                    EventSpecVip[]
  exhibitBooths               ExhibitBooth[]
  rfpContactFor               Rfp[]                     @relation("RfpContact")
  rfpDecisionMakerFor         Rfp[]                     @relation("RfpDecisionMaker")
  formLinks                   FormLink[]
  // Speaker facts that don't change between events (proposal #55). Bio is
  // plain text: it can arrive from a public form, so it is never HTML.
  bio                         String?
  pronouns                    String?
  jobTitle                    String?
  website                     String?
  headshotFileId              String?                   @unique
  headshotFile                FileUpload?               @relation("ContactHeadshot", fields: [headshotFileId], references: [id], onDelete: SetNull)
  files                       FileUpload[]              @relation("ContactFiles")
  speakerProfiles             SpeakerProfile[]
  updatedById                 String?
  updatedBy                   User?                     @relation("ContactUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@index([tenantId])
  @@index([updatedById])
}

// Junction table for Venue <-> Contact
model VenueContact {
  id        String  @id @default(cuid())
  venueId   String
  contactId String
  role      String? // e.g., "Sales Manager", "Event Coordinator"
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([venueId, contactId])
}

// Junction table for Event <-> Contact (key staff designations)
model EventKeyStaff {
  id                 String   @id @default(cuid())
  eventId            String
  contactId          String
  title              String?
  models             String[]
  sortOrder          Int      @default(0)
  // ESG Part I §C / §L / §X
  responsibilities   String?
  onSite             Boolean?
  isEmergencyContact Boolean  @default(false)
  approvalAuthority  String?

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([eventId, contactId, title])
}

// Function is the core scheduling unit
model Function {
  id                        String                         @id @default(cuid())
  name                      String
  description               String?
  type                      String                         @default("")
  notes                     String?
  offSiteLocation           String?
  status                    EntityStatus?
  substatus                 String?
  eventId                   String
  breakoutGroupId           String?
  // ESG function number ("12", "4a"). Assigned by src/lib/functionNumbers.ts;
  // pinned numbers are manual overrides the resequencer leaves alone.
  functionNumber            String?
  functionNumberPinned      Boolean                        @default(false)
  postToReaderBoard         Boolean?
  readerBoardText           String?
  hold24Hour                Boolean                        @default(false)
  // The set-up the function needs before any setup order exists (a
  // setup_type label); new setup orders from the function start from it.
  defaultSetup              String?
  expectedAttendance        Int?
  setForCount               Int?
  actualAttendance          Int?
  decorNotes                String?
  securityNotes             String?
  signageNotes              String?
  billingNotes              String?
  costCenter                String?
  roomNumbers               FunctionRoomNumber[]
  exhibitBooths             ExhibitBooth[]
  exhibitBoothGroups        ExhibitBoothGroup[]
  specTransfers             EventSpecTransfer[]
  specKeys                  EventSpecKey[]
  masterExhibitFor          EventSpecification[]           @relation("SpecMasterExhibit")
  event                     Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  breakoutGroup             BreakoutGroup?                 @relation(fields: [breakoutGroupId], references: [id], onDelete: SetNull)
  avOrderFunctions          AVOrderFunction[]
  setupOrderFunctions       SetupOrderFunction[]
  printOrderFunctions       PrintOrderFunction[]
  supplyOrderLinks          SupplyOrderFunction[]
  mediaDeliverableFunctions MediaDeliverableFunction[]
  rooms                     FunctionRoom[]
  contacts                  FunctionContact[]
  schedules                 FunctionSchedule[]
  presentationSlots         PresentationSlot[]
  sessionRoomOverrides      BreakoutSessionRoomOverride[]
  cateringOrder             CateringOrder?
  cateringServiceLocations  CateringOrderServiceLocation[] @relation("ServiceLocationFunction")
  timelineItems             TimelineItem[]
  rfpSpaceRequests          RfpSpaceRequest[]
  formLinks                 FormLink[]
  updatedById               String?
  updatedBy                 User?                          @relation("FunctionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  @@unique([eventId, functionNumber])
  @@index([eventId])
  @@index([breakoutGroupId])
  @@index([updatedById])
}

// Schedule items for a function (setup, rehearsal, main event, etc.)
model FunctionSchedule {
  id         String   @id @default(cuid())
  functionId String
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  type       String // From CustomOption category "schedule_type"
  startTime  DateTime
  endTime    DateTime
  notes      String?
  isPublic   Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([functionId])
}

// Junction table for Function <-> Room (many-to-many)
model FunctionRoom {
  id         String   @id @default(cuid())
  functionId String
  roomId     String
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([functionId, roomId])
}

// Junction table for Function <-> Contact (many-to-many)
model FunctionContact {
  id         String   @id @default(cuid())
  functionId String
  contactId  String
  role       String? // e.g., "Presenter", "Moderator", "Panelist"
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([functionId, contactId])
}

model AVOrder {
  id                String                @id @default(cuid())
  name              String
  status            EntityStatus?
  substatus         String?
  eventId           String
  event             Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  copiedFromId      String?
  copiedFrom        AVOrder?              @relation("AVOrderCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies            AVOrder[]             @relation("AVOrderCopies")
  notes             String?
  functionLinks     AVOrderFunction[]
  presentationLinks AVOrderPresentation[]
  audioSection      AudioSection?
  videoSection      VideoSection?
  equipmentItems    EquipmentItem[]
  vendors           AVOrderVendor[]
  files             FileUpload[]
  rfpLineItems      RfpLineItem[]
  updatedById       String?
  updatedBy         User?                 @relation("AVOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([eventId])
  @@index([copiedFromId])
  @@index([updatedById])
}

model AVOrderFunction {
  id         String   @id @default(cuid())
  avOrderId  String
  functionId String
  avOrder    AVOrder  @relation(fields: [avOrderId], references: [id], onDelete: Cascade)
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([avOrderId, functionId])
  @@index([functionId])
}

model AVOrderPresentation {
  id             String       @id @default(cuid())
  avOrderId      String
  presentationId String
  avOrder        AVOrder      @relation(fields: [avOrderId], references: [id], onDelete: Cascade)
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@unique([avOrderId, presentationId])
  @@index([presentationId])
}

model CateringOrder {
  id                         String                         @id @default(cuid())
  name                       String
  status                     EntityStatus?
  substatus                  String?
  eventId                    String
  event                      Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  functionId                 String?                        @unique
  function                   Function?                      @relation(fields: [functionId], references: [id], onDelete: SetNull)
  serviceStyle               String?
  mealType                   String?
  expectedCount              Int?
  confirmedCount             Int?
  guaranteeCount             Int?
  // Actual covers served (PER "# fed").
  actualCount                Int?
  staffingNotes              String?
  rentalMinimum              Decimal?
  fbMinimum                  Decimal?
  depositDeadline            DateTime?
  guaranteeDeadline          DateTime?
  paymentDeadline            DateTime?
  cancellationTerms          String?
  dietaryNotes               String?
  notes                      String?
  timelineItems              TimelineItem[]
  equipmentItems             EquipmentItem[]
  lineItems                  CateringOrderLineItem[]
  menuSections               CateringOrderMenuSection[]
  additionalServiceLocations CateringOrderServiceLocation[]
  contacts                   CateringOrderContact[]
  vendors                    CateringOrderVendor[]
  files                      FileUpload[]
  rfpSpaceRequests           RfpSpaceRequest[]
  rfpLineItems               RfpLineItem[]
  updatedById                String?
  updatedBy                  User?                          @relation("CateringOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  @@index([eventId])
  @@index([updatedById])
  @@map("BEO")
}

model TimelineItem {
  id              String         @id @default(cuid())
  cateringOrderId String?
  functionId      String?
  cateringOrder   CateringOrder? @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  function        Function?      @relation(fields: [functionId], references: [id], onDelete: Cascade)
  label           String
  startTime       DateTime
  endTime         DateTime?
  notes           String?
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([cateringOrderId])
  @@index([functionId])
}

model EquipmentItem {
  id                  String             @id @default(cuid())
  cateringOrderId     String?
  setupOrderId        String?
  videoSectionId      String?
  avOrderId           String?
  exhibitBoothId      String?
  exhibitBooth        ExhibitBooth?      @relation(fields: [exhibitBoothId], references: [id], onDelete: Cascade)
  // Standard inventory every booth in the group gets.
  exhibitBoothGroupId String?
  exhibitBoothGroup   ExhibitBoothGroup? @relation(fields: [exhibitBoothGroupId], references: [id], onDelete: Cascade)
  cateringOrder       CateringOrder?     @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  setupOrder          SetupOrder?        @relation(fields: [setupOrderId], references: [id], onDelete: Cascade)
  videoSection        VideoSection?      @relation(fields: [videoSectionId], references: [id], onDelete: Cascade)
  avOrder             AVOrder?           @relation(fields: [avOrderId], references: [id], onDelete: Cascade)
  equipmentId         String?
  equipment           Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  item                String
  quantity            Int?
  providerVendorId    String?
  providerVendor      Vendor?            @relation("EquipmentItemProviderVendor", fields: [providerVendorId], references: [id], onDelete: SetNull)
  providerContactId   String?
  providerContact     Contact?           @relation("EquipmentItemProviderContact", fields: [providerContactId], references: [id], onDelete: SetNull)
  operatorVendorId    String?
  operatorVendor      Vendor?            @relation("EquipmentItemOperatorVendor", fields: [operatorVendorId], references: [id], onDelete: SetNull)
  operatorContactId   String?
  operatorContact     Contact?           @relation("EquipmentItemOperatorContact", fields: [operatorContactId], references: [id], onDelete: SetNull)
  notes               String?
  sortOrder           Int                @default(0)
  rfpLineItems        RfpLineItem[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([cateringOrderId])
  @@index([setupOrderId])
  @@index([videoSectionId])
  @@index([avOrderId])
  @@index([exhibitBoothId])
  @@index([exhibitBoothGroupId])
  @@index([equipmentId])
  @@index([providerVendorId])
  @@index([providerContactId])
  @@index([operatorVendorId])
  @@index([operatorContactId])
}

model SetupOrder {
  id                String                   @id @default(cuid())
  name              String?
  setupType         String?
  status            EntityStatus?
  substatus         String?
  eventId           String
  event             Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roomId            String?
  room              Room?                    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  functionLinks     SetupOrderFunction[]
  presentationLinks SetupOrderPresentation[]
  notes             String?
  tables            SetupTable[]
  details           SetupOrderDetail[]
  equipmentItems    EquipmentItem[]
  vendors           SetupOrderVendor[]
  files             FileUpload[]
  updatedById       String?
  updatedBy         User?                    @relation("SetupOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([eventId])
  @@index([roomId])
  @@index([updatedById])
}

model SetupOrderFunction {
  id           String     @id @default(cuid())
  setupOrderId String
  functionId   String
  setupOrder   SetupOrder @relation(fields: [setupOrderId], references: [id], onDelete: Cascade)
  function     Function   @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([setupOrderId, functionId])
  @@index([functionId])
}

model SetupOrderPresentation {
  id             String       @id @default(cuid())
  setupOrderId   String
  presentationId String
  setupOrder     SetupOrder   @relation(fields: [setupOrderId], references: [id], onDelete: Cascade)
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@unique([setupOrderId, presentationId])
  @@index([presentationId])
}

model SetupTable {
  id               String     @id @default(cuid())
  setupOrderId     String
  setupOrder       SetupOrder @relation(fields: [setupOrderId], references: [id], onDelete: Cascade)
  quantity         Int
  tableType        String?
  chairCount       Int?
  chairType        String?
  providerVendorId String?
  providerVendor   Vendor?    @relation("SetupTableProviderVendor", fields: [providerVendorId], references: [id], onDelete: SetNull)
  notes            String?
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([setupOrderId])
  @@index([providerVendorId])
}

model SetupOrderDetail {
  id                       String     @id @default(cuid())
  setupOrderId             String
  setupOrder               SetupOrder @relation(fields: [setupOrderId], references: [id], onDelete: Cascade)
  headline                 String?
  description              String
  responsiblePartyVendorId String?
  responsiblePartyVendor   Vendor?    @relation("SetupOrderDetailResponsibleVendor", fields: [responsiblePartyVendorId], references: [id], onDelete: SetNull)
  sortOrder                Int        @default(0)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@index([setupOrderId])
  @@index([responsiblePartyVendorId])
}

model CateringOrderLineItem {
  id              String        @id @default(cuid())
  cateringOrderId String        @map("beoId")
  cateringOrder   CateringOrder @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  description     String
  unitType        String?
  unitPrice       Decimal?
  quantity        Int?
  notes           String?
  sortOrder       Int           @default(0)
  rfpLineItems    RfpLineItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([cateringOrderId])
  @@map("BEOLineItem")
}

model CateringOrderMenuSection {
  id                       String        @id @default(cuid())
  cateringOrderId          String        @map("beoId")
  cateringOrder            CateringOrder @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  responsiblePartyVendorId String?
  responsiblePartyVendor   Vendor?       @relation("MenuSectionResponsibleVendor", fields: [responsiblePartyVendorId], references: [id], onDelete: SetNull)
  menuContent              String
  notes                    String?
  sortOrder                Int           @default(0)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([cateringOrderId])
  @@index([responsiblePartyVendorId])
  @@map("BEOMenuSection")
}

model CateringOrderServiceLocation {
  id              String        @id @default(cuid())
  cateringOrderId String
  cateringOrder   CateringOrder @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  name            String?
  functionId      String?
  function        Function?     @relation("ServiceLocationFunction", fields: [functionId], references: [id], onDelete: SetNull)
  expectedCount   Int?
  notes           String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([cateringOrderId])
  @@index([functionId])
}

model CateringOrderContact {
  id              String        @id @default(cuid())
  cateringOrderId String        @map("beoId")
  contactId       String
  role            String?
  cateringOrder   CateringOrder @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([cateringOrderId, contactId])
  @@map("BEOContact")
}

// Presentation tracks (scoped per event)
model PresentationTrack {
  id            String         @id @default(cuid())
  name          String
  color         String?
  sortOrder     Int            @default(0)
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  presentations Presentation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([eventId, name])
  @@index([eventId])
}

// Breakout session groups (scoped per event)
model BreakoutGroup {
  id            String              @id @default(cuid())
  name          String
  sortOrder     Int                 @default(0)
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  functions     Function[]
  rooms         BreakoutGroupRoom[]
  presentations Presentation[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([eventId])
}

// Junction: BreakoutGroup <-> Room (group-level room assignment)
model BreakoutGroupRoom {
  id              String        @id @default(cuid())
  breakoutGroupId String
  roomId          String
  breakoutGroup   BreakoutGroup @relation(fields: [breakoutGroupId], references: [id], onDelete: Cascade)
  room            Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([breakoutGroupId, roomId])
}

// Per-session room overrides (exclude a group room or include a non-group room)
model BreakoutSessionRoomOverride {
  id         String   @id @default(cuid())
  functionId String
  roomId     String
  type       String // "exclude" or "include"
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([functionId, roomId])
}

// Junction: BREAKOUT_BLOCK function <-> Presentation, with optional room assignment
model PresentationSlot {
  id                String       @id @default(cuid())
  functionId        String
  presentationId    String
  roomId            String?
  advancerVendorId  String?
  advancerContactId String?
  function          Function     @relation(fields: [functionId], references: [id], onDelete: Cascade)
  presentation      Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  room              Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  advancerVendor    Vendor?      @relation("PresentationSlotAdvancerVendor", fields: [advancerVendorId], references: [id], onDelete: SetNull)
  advancerContact   Contact?     @relation("PresentationSlotAdvancerContact", fields: [advancerContactId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())

  @@unique([functionId, presentationId])
  @@index([presentationId])
}

// Presentation models for breakout sessions
model Presentation {
  id                    String                         @id @default(cuid())
  title                 String
  type                  String                         @default("")
  status                EntityStatus?
  substatus             String?
  description           String?
  schedulingNotes       String?                        @map("notes")
  internalNotes         String?
  instanceCount         Int                            @default(1)
  trackId               String?
  track                 PresentationTrack?             @relation(fields: [trackId], references: [id], onDelete: SetNull)
  breakoutGroupId       String?
  breakoutGroup         BreakoutGroup?                 @relation(fields: [breakoutGroupId], references: [id], onDelete: SetNull)
  eventId               String
  event                 Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speakers              PresentationContact[]
  slots                 PresentationSlot[]
  avOrderLinks          AVOrderPresentation[]
  setupOrderLinks       SetupOrderPresentation[]
  printOrder            PrintOrder?
  supplyOrderLinks      SupplyOrderPresentation[]
  mediaDeliverableLinks MediaDeliverablePresentation[]
  advancerVendorId      String?
  advancerVendor        Vendor?                        @relation("PresentationAdvancerVendor", fields: [advancerVendorId], references: [id], onDelete: SetNull)
  advancerContactId     String?
  advancerContact       Contact?                       @relation("PresentationAdvancerContact", fields: [advancerContactId], references: [id], onDelete: SetNull)
  updatedById           String?
  updatedBy             User?                          @relation("PresentationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  formLinks             FormLink[]
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@index([eventId])
  @@index([trackId])
  @@index([breakoutGroupId])
  @@index([updatedById])
}

model PresentationContact {
  id             String       @id @default(cuid())
  presentationId String
  contactId      String
  role           String? // "Presenter", "Co-Presenter", "Moderator", "Panelist"
  isPrimary      Boolean      @default(false)
  sortOrder      Int          @default(0)
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([presentationId, contactId])
  @@index([presentationId])
}

// Workflow system — hierarchical templates with sequential steps and optional checklist sub-items

model WorkflowTemplate {
  id                       String             @id @default(cuid())
  tenantId                 String
  tenant                   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                     String
  description              String?
  sortOrder                Int                @default(0)
  defaultForEntityTypes    String[]           @default([])
  pendingStatusValue       EntityStatus? // status applied when assigned but no steps completed yet
  pendingSubstatusValue    String?
  completionStatusValue    EntityStatus? // status applied when all steps in this workflow are complete
  completionSubstatusValue String?
  steps                    WorkflowStep[]
  instances                WorkflowInstance[]
  formLinks                FormLink[]
  updatedById              String?
  updatedBy                User?              @relation("WorkflowTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([tenantId])
  @@index([updatedById])
}

model WorkflowStep {
  id                    String                   @id @default(cuid())
  templateId            String
  template              WorkflowTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label                 String
  sortOrder             Int                      @default(0)
  computedKey           String? // reserved for future auto-derived checks (e.g., "HAS_ROOMS")
  pendingStatusValue    EntityStatus? // status applied while this step is the current (first incomplete) step
  pendingSubstatusValue String?
  items                 WorkflowChecklistItem[]
  completions           WorkflowStepCompletion[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([templateId])
}

model WorkflowChecklistItem {
  id          String                        @id @default(cuid())
  stepId      String
  step        WorkflowStep                  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  label       String
  sortOrder   Int                           @default(0)
  computedKey String? // reserved for future auto-derived checks
  completions WorkflowChecklistCompletion[]
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([stepId])
}

// Links a workflow template to a specific entity (CateringOrder, Function, AVOrder, etc.)
model WorkflowInstance {
  id              String                        @id @default(cuid())
  templateId      String
  template        WorkflowTemplate              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  entityType      String // "function", "catering_order", "av_order", "presentation"
  entityId        String
  stepCompletions WorkflowStepCompletion[]
  itemCompletions WorkflowChecklistCompletion[]
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@unique([templateId, entityType, entityId])
  @@index([entityType, entityId])
}

// Completion of a step — existence of this row means the step is complete
model WorkflowStepCompletion {
  id          String           @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId      String
  step        WorkflowStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  completedAt DateTime         @default(now())
  notes       String?

  @@unique([instanceId, stepId])
}

// Completion of a checklist item — existence of this row means the item is complete
model WorkflowChecklistCompletion {
  id          String                @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  itemId      String
  item        WorkflowChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  completedAt DateTime              @default(now())
  notes       String?

  @@unique([instanceId, itemId])
}

// Vendor management

model Vendor {
  id                          String                     @id @default(cuid())
  tenantId                    String
  tenant                      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                        String
  models                      String[]                   @default([]) // references ModelType values: CATERING_ORDER, AV_ORDER, SETUP_ORDER
  notes                       String?
  isSystemVendor              Boolean                    @default(false)
  venueId                     String?                    @unique
  venue                       Venue?                     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  contacts                    VendorContact[]
  eventVendors                EventVendor[]
  avOrderVendors              AVOrderVendor[]
  cateringOrderVendors        CateringOrderVendor[]
  setupOrderVendors           SetupOrderVendor[]
  printOrderVendors           PrintOrderVendor[]
  supplyOrdersAsProvider      SupplyOrder[]              @relation("SupplyOrderProviderVendor")
  supplyOrderItemsAsProvider  SupplyOrderItem[]          @relation("SupplyOrderItemProviderVendor")
  mediaDeliverablesAsProvider MediaDeliverable[]         @relation("MediaDeliverableProviderVendor")
  printItemsAsDesigner        PrintItem[]                @relation("PrintItemDesignerVendor")
  printItemsAsPrinter         PrintItem[]                @relation("PrintItemPrinterVendor")
  equipmentItemsAsProvider    EquipmentItem[]            @relation("EquipmentItemProviderVendor")
  equipmentItemsAsOperator    EquipmentItem[]            @relation("EquipmentItemOperatorVendor")
  responsibleMenuSections     CateringOrderMenuSection[] @relation("MenuSectionResponsibleVendor")
  responsibleSetupDetails     SetupOrderDetail[]         @relation("SetupOrderDetailResponsibleVendor")
  inputGroupsAsProvider       InputGroup[]               @relation("InputGroupProviderVendor")
  inputGroupsAsOperator       InputGroup[]               @relation("InputGroupOperatorVendor")
  inputItemsAsProvider        InputItem[]                @relation("InputItemProviderVendor")
  inputItemsAsOperator        InputItem[]                @relation("InputItemOperatorVendor")
  monitorMixesAsProvider      MonitorMix[]               @relation("MonitorMixProviderVendor")
  monitorMixesAsOperator      MonitorMix[]               @relation("MonitorMixOperatorVendor")
  monitorOutputsAsProvider    MonitorOutput[]            @relation("MonitorOutputProviderVendor")
  monitorOutputsAsOperator    MonitorOutput[]            @relation("MonitorOutputOperatorVendor")
  setupTablesAsProvider       SetupTable[]               @relation("SetupTableProviderVendor")
  presentationsAsAdvancer     Presentation[]             @relation("PresentationAdvancerVendor")
  presentationSlotsAsAdvancer PresentationSlot[]         @relation("PresentationSlotAdvancerVendor")
  specSecurityFor             EventSpecification[]       @relation("SpecSecurityVendor")
  specFirstAidFor             EventSpecification[]       @relation("SpecFirstAidVendor")
  specTransportationFor       EventSpecification[]       @relation("SpecTransportationVendor")
  rfpRecipients               RfpRecipient[]
  vendorQuotes                VendorQuote[]
  leadSourceFor               HotelProposal[]            @relation("HotelProposalLeadSource")
  updatedById                 String?
  updatedBy                   User?                      @relation("VendorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  @@index([tenantId])
  @@index([updatedById])
}

// Junction: Vendor <-> Contact
model VendorContact {
  id          String  @id @default(cuid())
  vendorId    String
  contactId   String
  contactType String? // from vendor_contact_type CustomOption
  isPrimary   Boolean @default(false)
  vendor      Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  contact     Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([vendorId, contactId])
}

// Junction: Event <-> Vendor (with optional default-per-model-type designation)
// Valid defaultFor values: "CATERING_ORDER", "AV_ORDER", "SETUP_ORDER"
// When a new document model with vendor support is added, add its identifier here
// and wire up auto-assignment in its create action.
model EventVendor {
  id         String   @id @default(cuid())
  eventId    String
  vendorId   String
  defaultFor String[] @default([])
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId])
  @@index([eventId])
}

// Junction: AVOrder <-> Vendor
model AVOrderVendor {
  id        String  @id @default(cuid())
  avOrderId String
  vendorId  String
  notes     String?
  avOrder   AVOrder @relation(fields: [avOrderId], references: [id], onDelete: Cascade)
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([avOrderId, vendorId])
  @@index([avOrderId])
}

// Junction: CateringOrder <-> Vendor
model CateringOrderVendor {
  id              String        @id @default(cuid())
  cateringOrderId String        @map("beoId")
  vendorId        String
  notes           String?
  cateringOrder   CateringOrder @relation(fields: [cateringOrderId], references: [id], onDelete: Cascade)
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([cateringOrderId, vendorId])
  @@index([cateringOrderId])
  @@map("BEOVendor")
}

// Junction: SetupOrder <-> Vendor
model SetupOrderVendor {
  id           String     @id @default(cuid())
  setupOrderId String
  vendorId     String
  notes        String?
  setupOrder   SetupOrder @relation(fields: [setupOrderId], references: [id], onDelete: Cascade)
  vendor       Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([setupOrderId, vendorId])
  @@index([setupOrderId])
}

