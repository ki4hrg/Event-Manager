// RBAC

enum PermissionResource {
  ROLES
  USERS
  SETTINGS
  SYSTEM
  EQUIPMENT
  STORAGE_LOCATIONS
  WORKFLOWS
  VENDORS
  VENUES
  CONTACTS
  EVENTS
  FUNCTIONS
  PRESENTATIONS
  AV_ORDERS
  CATERING_ORDERS
  SETUP_ORDERS
  PRINT_ORDERS
  SUPPLY_ORDERS
  MEDIA_DELIVERABLES
  FILES
  SHARE_LINKS
  API_KEYS
}

enum PermissionLevel {
  NONE
  VIEW
  WRITE
  DELETE
}

enum PermissionScope {
  GLOBAL
  ASSIGNED
  UNASSIGNED
}

model Role {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  // System roles (seeded Admin/User) cannot be renamed or deleted from the UI.
  isSystem    Boolean            @default(false)
  permissions RolePermission[]
  memberships TenantMembership[]
  updatedById String?
  updatedBy   User?              @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([updatedById])
}

model RolePermission {
  id       String             @id @default(cuid())
  roleId   String
  role     Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource PermissionResource
  scope    PermissionScope
  level    PermissionLevel    @default(NONE)

  @@unique([roleId, resource, scope])
  @@index([roleId])
}

// Junction linking app Users to Events they are staff on. Distinct from EventKeyStaff (Contacts).
model EventStaff {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  // Caps the user's role-derived ASSIGNED level for THIS event only. Cap-only:
  // it can narrow (WRITE role -> VIEW here) but never widen, so setting one can
  // never escalate anyone past their role. null = uncapped, role level applies.
  // Applied in resolvePermissionForUser, so it covers every event-scoped
  // resource for the event, not just EVENTS.
  accessLevel PermissionLevel?

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}

// ─── APEX / EIC Event Specifications Guide ────────────────────────────────
// Field-level meaning lives in src/lib/esg/fields.ts. Structured values are
// columns; every free-text / rich-text ESG field is a key in `narrative`.

enum ProvidedBy {
  NOT_REQUIRED
  GROUP
  VENUE
  OUTSIDE_VENDOR
}

model EventSpecification {
  id      String @id @default(cuid())
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  dateOriginated DateTime? @db.Date
  dateRevised    DateTime? @db.Date
  naSections     String[]  @default([])
  narrative      Json      @default("{}")

  // §A Event profile
  eventType               String?
  eventScope              String?
  eventFrequency          String?
  isMandatory             Boolean?
  spousesInvited          Boolean?
  childrenInvited         Boolean?
  // §B Key dates
  preMeetingAt            DateTime?
  postMeetingAt           DateTime?
  moveInRequired          Boolean?
  // §D / §E Attendee & exhibitor profile
  preRegisteredCount      Int?
  domesticCount           Int?
  internationalCount      Int?
  exhibitorCount          Int?
  domesticExhibitors      Int?
  internationalExhibitors Int?
  exhibitingCompanies     Int?
  // §G Housing
  thirdPartyHousing       Boolean?
  reservationMethod       String?
  // §J Exhibits
  masterExhibitFunctionId String?
  masterExhibitFunction   Function?   @relation("SpecMasterExhibit", fields: [masterExhibitFunctionId], references: [id], onDelete: SetNull)
  grossSqFt               Int?
  netSqFt                 Int?
  povDeliveries           Int?
  rulesAttached           Boolean?
  exhibitorMoveInStart    DateTime?
  exhibitorMoveInEnd      DateTime?
  exhibitorMoveOutStart   DateTime?
  exhibitorMoveOutEnd     DateTime?
  contractorMoveInStart   DateTime?
  contractorMoveInEnd     DateTime?
  contractorMoveOutStart  DateTime?
  contractorMoveOutEnd    DateTime?
  // §L Safety & security
  securityProvider        ProvidedBy?
  securityVendorId        String?
  securityVendor          Vendor?     @relation("SpecSecurityVendor", fields: [securityVendorId], references: [id], onDelete: SetNull)
  firstAidProvider        ProvidedBy?
  firstAidVendorId        String?
  firstAidVendor          Vendor?     @relation("SpecFirstAidVendor", fields: [firstAidVendorId], references: [id], onDelete: SetNull)
  // §P Transportation
  attendeeShuttle         Boolean?
  offsiteShuttles         Boolean?
  transportationVendorId  String?
  transportationVendor    Vendor?     @relation("SpecTransportationVendor", fields: [transportationVendorId], references: [id], onDelete: SetNull)
  // §W Billing
  finalBillContactId      String?
  finalBillContact        Contact?    @relation("SpecFinalBillContact", fields: [finalBillContactId], references: [id], onDelete: SetNull)
  taxExempt               Boolean?
  roomTaxToMaster         Boolean?
  incidentalsToMaster     Boolean?
  guestsPayOwn            Boolean?

  updatedById String?
  updatedBy   User?    @relation("EventSpecificationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([masterExhibitFunctionId])
  @@index([securityVendorId])
  @@index([firstAidVendorId])
  @@index([transportationVendorId])
  @@index([finalBillContactId])
  @@index([updatedById])
}

// §H VIPs
model EventSpecVip {
