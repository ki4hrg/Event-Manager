generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Core entities
model Event {
  id          String     @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  timezone    String     @default("America/Chicago")
  venueId     String?
  venue       Venue?     @relation(fields: [venueId], references: [id])
  functions   Function[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Venue {
  id        String         @id @default(cuid())
  name      String
  address   String?
  city      String?
  state     String?
  zip       String?
  country   String?
  notes     String?
  rooms     Room[]
  events    Event[]
  contacts  VenueContact[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Room {
  id        String         @id @default(cuid())
  name      String
  capacity  Int?
  notes     String?
  venueId   String
  venue     Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  functions FunctionRoom[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// Flexible contact model with roles
model Contact {
  id             String            @id @default(cuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  organization   String?
  notes          String?
  roles          ContactRole[]     @default([])
  functions      FunctionContact[]
  venues         VenueContact[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

enum ContactRole {
  SPEAKER
  VENUE_CONTACT
  VENDOR
  STAFF
  OTHER
}

// Junction table for Venue <-> Contact
model VenueContact {
  id        String  @id @default(cuid())
  venueId   String
  contactId String
  role      String? // e.g., "Sales Manager", "Event Coordinator"
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([venueId, contactId])
}

// Function is the core scheduling unit
model Function {
  id          String            @id @default(cuid())
  name        String
  description String?
  type        FunctionType      @default(GENERAL)
  date        DateTime          @db.Date
  startTime   DateTime          @db.Time()
  endTime     DateTime          @db.Time()
  setupNotes  String?
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rooms       FunctionRoom[]
  contacts    FunctionContact[]
  avNeeds     AVNeeds?
  beoDetails  BEODetails?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([eventId])
  @@index([date])
}

enum FunctionType {
  GENERAL
  MEAL
  BREAKOUT
  PLENARY
}

// Junction table for Function <-> Room (many-to-many)
model FunctionRoom {
  id         String   @id @default(cuid())
  functionId String
  roomId     String
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([functionId, roomId])
}

// Junction table for Function <-> Contact (many-to-many)
model FunctionContact {
  id         String   @id @default(cuid())
  functionId String
  contactId  String
  role       String?  // e.g., "Presenter", "Moderator", "Panelist"
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([functionId, contactId])
}

// AV Requirements for a function
model AVNeeds {
  id            String   @id @default(cuid())
  functionId    String   @unique
  function      Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  projector     Boolean  @default(false)
  screen        Boolean  @default(false)
  microphone    Boolean  @default(false)
  podium        Boolean  @default(false)
  webcast       Boolean  @default(false)
  recording     Boolean  @default(false)
  videoPlayback Boolean  @default(false)
  notes         String?
}

// BEO (Banquet Event Order) details for meal functions
model BEODetails {
  id             String   @id @default(cuid())
  functionId     String   @unique
  function       Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  guaranteeCount Int?
  tableSetup     String?
  menuNotes      String?
  dietaryNotes   String?
  beverageNotes  String?
  notes          String?
}
