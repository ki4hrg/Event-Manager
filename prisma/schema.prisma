generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Customizable options for dropdowns
model CustomOption {
  id        String   @id @default(cuid())
  category  String   // "function_type", "contact_role", "av_equipment"
  value     String   // The stored value (e.g., "MEAL", "SPEAKER")
  label     String   // The display label (e.g., "Meal / BEO", "Speaker")
  color     String?  // Optional color for badges (e.g., "orange", "blue")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@index([category])
}

// Core entities
model Event {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  startDate          DateTime
  endDate            DateTime
  timezone           String              @default("America/Chicago")
  venueId            String?
  venue              Venue?              @relation(fields: [venueId], references: [id])
  functions          Function[]
  presentations      Presentation[]
  presentationTracks PresentationTrack[]
  avOrders           AVOrder[]
  beos               BEO[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Venue {
  id        String         @id @default(cuid())
  name      String
  address   String?
  city      String?
  state     String?
  zip       String?
  country   String?
  notes     String?
  rooms     Room[]
  events    Event[]
  contacts  VenueContact[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Room {
  id        String         @id @default(cuid())
  name      String
  capacity  Int?
  notes     String?
  venueId   String
  venue     Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  functions FunctionRoom[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// Flexible contact model with roles
model Contact {
  id            String                @id @default(cuid())
  firstName     String
  lastName      String
  email         String?
  phone         String?
  organization  String?
  notes         String?
  roles         String[]              @default([])
  functions     FunctionContact[]
  venues        VenueContact[]
  presentations PresentationContact[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

// Junction table for Venue <-> Contact
model VenueContact {
  id        String  @id @default(cuid())
  venueId   String
  contactId String
  role      String? // e.g., "Sales Manager", "Event Coordinator"
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([venueId, contactId])
}

// Function is the core scheduling unit
model Function {
  id           String             @id @default(cuid())
  name         String
  description  String?
  type         String             @default("")
  setupNotes   String?
  eventId      String
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rooms        FunctionRoom[]
  contacts     FunctionContact[]
  schedules    FunctionSchedule[]
  avOrder      AVOrder?
  beo          BEO?
  presentation Presentation?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([eventId])
}

// Schedule items for a function (setup, rehearsal, main event, etc.)
model FunctionSchedule {
  id         String   @id @default(cuid())
  functionId String
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  type       String   // From CustomOption category "schedule_type"
  startTime  DateTime
  endTime    DateTime
  notes      String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([functionId])
}

// Junction table for Function <-> Room (many-to-many)
model FunctionRoom {
  id         String   @id @default(cuid())
  functionId String
  roomId     String
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([functionId, roomId])
}

// Junction table for Function <-> Contact (many-to-many)
model FunctionContact {
  id         String   @id @default(cuid())
  functionId String
  contactId  String
  role       String? // e.g., "Presenter", "Moderator", "Panelist"
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([functionId, contactId])
}

model AVOrder {
  id             String        @id @default(cuid())
  name           String
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  functionId     String?       @unique
  function       Function?     @relation(fields: [functionId], references: [id], onDelete: SetNull)
  presentationId String?       @unique
  presentation   Presentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  equipment      String[]      @default([])
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([eventId])
}

model BEO {
  id             String    @id @default(cuid())
  name           String
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  functionId     String?   @unique
  function       Function? @relation(fields: [functionId], references: [id], onDelete: SetNull)
  guaranteeCount Int?
  tableSetup     String?
  menuNotes      String?
  dietaryNotes   String?
  beverageNotes  String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([eventId])
}

// Presentation tracks (scoped per event)
model PresentationTrack {
  id            String         @id @default(cuid())
  name          String
  color         String?
  sortOrder     Int            @default(0)
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  presentations Presentation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([eventId, name])
  @@index([eventId])
}

// Presentation models for breakout sessions
model Presentation {
  id          String                @id @default(cuid())
  title       String
  description String?
  notes       String?
  trackId     String?
  track       PresentationTrack?    @relation(fields: [trackId], references: [id], onDelete: SetNull)
  functionId  String?               @unique
  function    Function?             @relation(fields: [functionId], references: [id], onDelete: SetNull)
  eventId     String
  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speakers    PresentationContact[]
  avOrder     AVOrder?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([eventId])
  @@index([trackId])
}

model PresentationContact {
  id             String       @id @default(cuid())
  presentationId String
  contactId      String
  role           String?      // "Presenter", "Co-Presenter", "Moderator", "Panelist"
  isPrimary      Boolean      @default(false)
  sortOrder      Int          @default(0)
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([presentationId, contactId])
  @@index([presentationId])
}

